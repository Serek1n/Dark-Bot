# ==== Discord Application ====
DISCORD_TOKEN=your-bot-token
DISCORD_CLIENT_ID=your-application-client-id
DISCORD_CLIENT_SECRET=your-application-client-secret

# Used both for bot slash-command registration (leave empty to register globally)
# and is NOT required by the web app.
DEV_GUILD_ID=

# ==== Web dashboard ====
WEB_PORT=3000
# Панель работает внутри процесса бота; false — не запускать её (например, чтобы вести отдельным процессом: node web/index.js)
DATA_KEY=            # необязательно: ключ шифрования токена вебхука логов (если пусто — берётся SESSION_SECRET); не меняйте его после запуска
WEB_ENABLED=true
# beta | release — какая версия запущена. Обычно не нужно: бот сам смотрит на git-ветку (beta = бета); задайте, если нет папки .git (Docker)
BOT_CHANNEL=
WEB_BASE_URL=http://localhost:3000
SESSION_SECRET=   # обязательно: случайная строка от 24 символов (openssl rand -hex 32), без неё панель не запустится
# Comma-separated Discord user IDs who can access every guild's dashboard regardless of permissions
BOT_OWNER_IDS=

# ==== Database ====
# SQLite file path, relative to project root
DATABASE_PATH=./data/dark.sqlite

# ==== Optional integrations ====
# YouTube Data API v3 key - needed for /addyoutube alerts
YOUTUBE_API_KEY=
# Twitch app credentials - needed for /addtwitch alerts
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# How often (minutes) the alert poller checks YouTube/Twitch for updates
ALERT_POLL_INTERVAL_MINUTES=5

# Через сколько минут бездействия бот выходит из голосового канала
VOICE_IDLE_MINUTES=5

# Контакт для вопросов об условиях и данных (показывается на страницах /terms и /privacy).
# Например: «разработчику в Discord: @ник» или e-mail.
CONTACT_INFO=

# --- Музыка (необязательно) ---
# Файл cookies.txt от аккаунта YouTube: нужен для видео с возрастным ограничением и при ошибке
# "Sign in to confirm you're not a bot". Экспортируйте его расширением "Get cookies.txt LOCALLY".
# YTDLP_COOKIES=/opt/Dark-Bot/cookies.txt
# Дополнительные параметры yt-dlp. Новым версиям yt-dlp для YouTube нужен JS-рантайм (у нас есть Node):
# YTDLP_EXTRA_ARGS=--js-runtimes node
