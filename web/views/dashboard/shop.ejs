<!DOCTYPE html>
<html lang="ru">
<head><%- include('../partials/head', { title: guild.name + ' — Магазин' }) %></head>
<body>
  <div class="app-layout">
    <%- include('../partials/sidebar') %>
    <div class="content">
      <div class="page-header">
        <h1>Магазин</h1>
        <p class="page-intro">Участники тратят монеты и кристаллы командой <code>/shop</code>. Товар — это роль (выдаётся сразу) или «предмет» (текст с выдачей или ручная выдача).</p>
      </div>
      <% const n = (v) => Number(v).toLocaleString('ru-RU'); const cn = (c) => c === 'crystals' ? settings.crystalName : settings.currencyName; %>

      <form method="post" action="/dashboard/<%= guild.id %>/shop/settings" class="card">
        <h2>Настройки</h2>
        <label class="checkbox-row"><input type="checkbox" name="shopEnabled" <%= settings.shopEnabled ? 'checked' : '' %> /> Магазин включён</label>
        <div>
          <label>Канал для журнала покупок</label>
          <select name="shopLogChannelId">
            <option value="">Не отправлять</option>
            <% channels.filter(c => c.type === 0).forEach(c => { %>
              <option value="<%= c.id %>" <%= settings.shopLogChannelId === c.id ? 'selected' : '' %>>#<%= c.name %></option>
            <% }) %>
          </select>
        </div>
        <button class="btn" type="submit">Сохранить</button>
      </form>

      <div class="card">
        <h2>Товары <span class="muted">(<%= items.length %> из <%= maxItems %>)</span></h2>
        <% if (!items.length) { %><p class="empty-state">Товаров пока нет. Добавьте первый ниже.</p><% } %>
        <% items.forEach(it => { %>
          <details class="shop-item" style="margin-bottom:10px;">
            <summary>
              <strong><%= it.name %></strong>
              — <%= n(it.price) %> <%= cn(it.currency) %>
              <span class="muted"> · <%= it.type === 'role' ? 'роль' + (it.durationSeconds ? ' на ' + termText(it.durationSeconds * 1000) : '') : 'предмет' %><%= it.stock !== null ? ' · осталось ' + it.stock : '' %><%= it.enabled ? '' : ' · скрыт' %></span>
            </summary>
            <form method="post" action="/dashboard/<%= guild.id %>/shop/items/<%= it.id %>" data-no-guard>
              <%- include('../partials/shop-fields', { it, roles, settings }) %>
              <div class="btn-row">
                <button class="btn" type="submit">Сохранить товар</button>
                <button class="btn btn-danger" type="submit" form="shopdel-<%= it.id %>">Удалить</button>
              </div>
            </form>
            <form id="shopdel-<%= it.id %>" method="post" action="/dashboard/<%= guild.id %>/shop/items/<%= it.id %>/delete" data-no-guard onsubmit="return confirm('Удалить товар «<%= it.name.replace(/['"\\]/g, '') %>»?')"></form>
          </details>
        <% }) %>
      </div>

      <% if (items.length < maxItems) { %>
      <form method="post" action="/dashboard/<%= guild.id %>/shop/items" class="card" data-no-guard>
        <h2>Новый товар</h2>
        <%- include('../partials/shop-fields', { it: { name: '', description: '', price: 100, currency: 'coins', type: 'item', roleId: null, durationSeconds: null, stock: null, minLevel: 0, deliveryMessage: '', enabled: true }, roles, settings }) %>
        <button class="btn" type="submit">Добавить</button>
      </form>
      <% } %>

      <div class="card">
        <h2>Роли на время <% if (terms.length) { %><span class="muted">· <%= terms.length %><%= terms.length >= 100 ? '+' : '' %></span><% } %></h2>
        <p class="hint" style="margin-top:0">Купленные в магазине на срок и выданные командой <code>/temprole</code>. Когда срок выйдет, бот снимет роль сам.</p>
        <% if (!terms.length) { %>
          <p class="empty-state">Сейчас ни у кого нет ролей на время.</p>
        <% } else { %>
          <div class="table-wrap"><div class="table-scroll"><table>
            <thead><tr><th>Участник</th><th>Роль</th><th>Откуда</th><th>До</th><th></th></tr></thead>
            <tbody>
              <% terms.forEach(t => { const u = users[t.userId] || { name: t.userId }; const r = roles.find(x => x.id === t.roleId); const end = new Date(t.expiresAt); const shopId = String(t.givenBy || '').startsWith('shop:') ? Number(String(t.givenBy).slice(5)) : null; const it = shopId ? items.find(x => x.id === shopId) : null; %>
                <tr>
                  <td><%= u.name %></td>
                  <td><%= r ? '@' + r.name : t.roleId %></td>
                  <td><%= shopId ? 'магазин' + (it ? ': ' + it.name : '') : '/temprole' %></td>
                  <td><time datetime="<%= end.toISOString() %>" title="<%= end.toISOString() %>"><%= end.toLocaleString('ru-RU', { timeZone: process.env.TZ || 'Europe/Moscow', day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) %></time></td>
                  <td>
                    <form method="post" action="/dashboard/<%= guild.id %>/shop/terms/<%= t.id %>/revoke" data-no-guard onsubmit="return confirm('Снять роль сейчас, не дожидаясь конца срока?')">
                      <button class="btn btn-danger" type="submit"<%= r && r.blocked ? ' disabled title="' + r.blocked + '"' : '' %>>Снять</button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table></div></div>
        <% } %>
      </div>

      <div class="card">
        <h2>Покупки <% if (pending) { %><span class="muted">· ждут выдачи: <%= pending %></span><% } %></h2>
        <% if (!purchases.length) { %>
          <p class="empty-state">Покупок пока не было.</p>
        <% } else { %>
          <div class="table-wrap"><div class="table-scroll"><table>
            <thead><tr><th>Участник</th><th>Товар</th><th>Цена</th><th>Статус</th><th></th></tr></thead>
            <tbody>
              <% purchases.forEach(p => { const u = users[p.userId] || { name: p.userId }; %>
                <tr>
                  <td><%= u.name %></td>
                  <td><%= p.itemName %></td>
                  <td><%= n(p.price) %> <%= cn(p.currency) %></td>
                  <td><%= { done: 'Выдано', pending: 'Ждёт выдачи', refunded: 'Возвращено' }[p.status] || p.status %></td>
                  <td>
                    <div class="btn-row">
                      <% if (p.status === 'pending') { %>
                        <form method="post" action="/dashboard/<%= guild.id %>/shop/purchases/<%= p.id %>/deliver" data-no-guard><button class="btn" type="submit">Выдано</button></form>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table></div></div>
        <% } %>
      </div>
    </div>
  </div>
</body>
</html>
