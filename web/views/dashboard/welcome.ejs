<!DOCTYPE html>
<html lang="ru">
<head><%- include('../partials/head', { title: guild.name + ' — Приветствие' }) %></head>
<body>
  <div class="app-layout">
    <%- include('../partials/sidebar') %>
    <div class="content">
      <div class="page-header">
        <h1>Приветствие и автороль</h1>
        <p class="page-intro">Сообщение и роль, которые получает новый участник сразу после входа на сервер.</p>
      </div>
      <form method="post" class="card">
        <div>
          <label>Канал приветствия</label>
          <select name="welcomeChannelId">
            <option value="">— выключено —</option>
            <% channels.filter(c => c.type === 0).forEach(c => { %>
              <option value="<%= c.id %>" <%= settings.welcomeChannelId === c.id ? 'selected' : '' %>>#<%= c.name %></option>
            <% }) %>
          </select>
        </div>
        <div>
          <label>Текст приветствия — доступны {user} и {server}</label>
          <textarea name="welcomeMessage" id="welcomeMessage" maxlength="1800"><%= settings.welcomeMessage %></textarea>
        </div>
        <div>
          <label>Как это увидят в Discord</label>
          <div class="preview">
            <div class="pv-avatar"><svg width="22" height="22" viewBox="0 0 56 56" aria-hidden="true"><mask id="pv-moon"><rect width="56" height="56" fill="#fff"/><circle cx="36" cy="20" r="15" fill="#000"/></mask><circle cx="27" cy="29" r="19" fill="#e3a857" mask="url(#pv-moon)"/></svg></div>
            <div><div class="pv-name">Dark<em>БОТ</em></div><div id="welcomePreview"></div></div>
          </div>
        </div>
        <div>
          <label>Роль, выдаваемая автоматически при входе</label>
          <select name="autoRoleId">
            <option value="">— не выбрано —</option>
            <% roles.forEach(r => { %>
              <option value="<%= r.id %>" <%= settings.autoRoleId === r.id ? 'selected' : '' %>>@<%= r.name %></option>
            <% }) %>
          </select>
        </div>
        <button class="btn" type="submit">Сохранить</button>
      </form>
    </div>
  </div>
  <script>
    (function () {
      var input = document.getElementById('welcomeMessage');
      var out = document.getElementById('welcomePreview');
      var server = <%- JSON.stringify(guild.name).replace(/</g, '\\u003c') %>;
      function esc(t) { return t.replace(/[&<>]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c]; }); }
      function render() {
        out.innerHTML = esc(input.value)
          .replace(/\{user\}/g, '<span class="mention">@Новый участник</span>')
          .replace(/\{server\}/g, esc(server));
      }
      input.addEventListener('input', render);
      render();
    })();
  </script>
</body>
</html>
