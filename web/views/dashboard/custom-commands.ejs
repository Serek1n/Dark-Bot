<!DOCTYPE html>
<html lang="ru">
<head><%- include('../partials/head', { title: guild.name + ' — Кастом-команды' }) %></head>
<body>
  <div class="app-layout">
    <%- include('../partials/sidebar') %>
    <div class="content">
      <div class="page-header">
        <h1>Кастомные команды</h1>
        <p class="page-intro">Простые текстовые команды по префиксу — участник пишет триггер, бот отвечает заданным текстом.</p>
      </div>

      <form method="post" class="card">
        <h2>Новая команда</h2>
        <div>
          <label>Триггер (без префикса)</label>
          <input type="text" name="trigger" placeholder="rules" required />
        </div>
        <div>
          <label>Ответ бота</label>
          <textarea name="response" placeholder="Правила сервера: ..." required></textarea>
        </div>
        <button class="btn" type="submit">Добавить / обновить</button>
      </form>

      <div class="card">
        <% if (!commands.length) { %>
          <p class="empty-state"><svg width="26" height="26" viewBox="0 0 20 20" fill="currentColor"><path d="M13 3.5C10.5 4.8 8.8 7.3 8.8 10.2C8.8 13.1 10.5 15.6 13 16.9C11.6 17.8 9.9 18.3 8.1 18.3C3.6 18.3 0 14.5 0 10C0 5.5 3.6 1.7 8.1 1.7C9.9 1.7 11.6 2.2 13 3.5Z"/></svg>Кастомных команд пока нет.</p>
        <% } else { %>
          <table>
            <thead><tr><th>Триггер</th><th>Ответ</th><th></th></tr></thead>
            <tbody>
              <% commands.forEach(c => { %>
                <tr>
                  <td><code><%= c.trigger %></code></td>
                  <td><%= c.response.length > 80 ? c.response.slice(0, 80) + '…' : c.response %></td>
                  <td>
                    <form method="post" action="/dashboard/<%= guild.id %>/custom-commands/delete/<%= c.id %>">
                      <button class="btn btn-danger" type="submit">Удалить</button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } %>
      </div>
    </div>
  </div>
</body>
</html>
