<!DOCTYPE html>
<html lang="ru">
<head><%- include('../partials/head', { title: guild.name + ' — Экономика' }) %></head>
<body>
  <div class="app-layout with-nav">
    <%- include('../partials/sidebar') %>
    <main class="content <%= (locals.M || global.__darkModules).layoutOf(locals.active) %>" id="main" tabindex="-1">
      <div class="page-header">
        <%- include('../partials/module-head') %>
        <h1>Экономика</h1>
        <p class="page-intro">Две валюты с разными источниками. Сколько выдавать за чат и голос, настраивается на странице «Уровни».</p>
      </div>
      <% const n = (v) => Number(v).toLocaleString('ru-RU'); const cap = (s) => { s = String(s || ''); return s.charAt(0).toLocaleUpperCase('ru-RU') + s.slice(1); };
         const ec = locals.econ || { FEATURES: [], PRESETS: [], mode: 'simple', preset: 'calm', flags: {}, on: [], params: {} }; %>
      <div class="stat-row">
        <div class="stat-box"><div class="value"><%= n(stats.coinsTotal) %></div><div class="label"><%= cap(settings.currencyName) %> в обороте</div></div>
        <div class="stat-box"><div class="value"><%= n(stats.crystalsTotal) %></div><div class="label"><%= cap(settings.crystalName) %> в обороте</div></div>
        <div class="stat-box"><div class="value"><%= n(stats.holders) %></div><div class="label">Участников с деньгами</div></div>
      </div>
      <% const A = locals.A || (() => ''); %>
      <form method="post" class="set-page" data-api="economy.currency">
        <section class="card set-section">
          <h2>Валюты</h2>
          <div class="set-row">
            <div class="set-text"><label for="currencyName">Основная валюта</label><p class="set-help">За сообщения, время в голосе и ежедневную награду. Участники переводят её друг другу: <code>/pay</code></p></div>
            <div class="set-ctl"><input type="text" id="currencyName" name="currencyName" value="<%= settings.currencyName %>" <%- A('economy.currency', 'currencyName') %> /></div>
          </div>
          <div class="set-row">
            <div class="set-text"><label for="crystalName">Редкая валюта</label><p class="set-help">Только за новые уровни. Сколько за каждый — в «Уровни → Награды и роли»</p></div>
            <div class="set-ctl"><input type="text" id="crystalName" name="crystalName" value="<%= settings.crystalName %>" <%- A('economy.currency', 'crystalName') %> /></div>
          </div>
        </section>
        <section class="card set-section">
          <h2>Ежедневная награда<span class="sub">Команда <code>/daily</code></span></h2>
          <div class="set-row">
            <div class="set-text"><label for="dailyCoins">Награда</label><p class="set-help">0 — команда ничего не даёт</p></div>
            <div class="set-ctl"><input type="number" id="dailyCoins" name="dailyCoins" value="<%= settings.dailyCoins %>" <%- A('economy.currency', 'dailyCoins') %> /><span class="set-unit"><%= settings.currencyName %></span></div>
          </div>
          <div class="set-row">
            <div class="set-text"><label for="dailyStreakBonus">Прибавка за каждый день серии</label><p class="set-help">Заходят за наградой каждый день подряд — награда растёт</p></div>
            <div class="set-ctl"><input type="number" id="dailyStreakBonus" name="dailyStreakBonus" value="<%= settings.dailyStreakBonus %>" <%- A('economy.currency', 'dailyStreakBonus') %> /><span class="set-unit">за день</span></div>
          </div>
          <div class="set-row">
            <div class="set-text"><label for="dailyStreakMax">Серия растёт до</label></div>
            <div class="set-ctl"><input type="number" id="dailyStreakMax" name="dailyStreakMax" value="<%= settings.dailyStreakMax %>" <%- A('economy.currency', 'dailyStreakMax') %> /><span class="set-unit">дней</span></div>
          </div>
          <div class="set-actions">
            <button class="btn" type="submit">Сохранить</button>
            <button class="btn btn-secondary set-reset" type="button" data-reset-section="economy.currency">Сбросить к стандартным</button>
          </div>
        </section>
      </form>

      <form method="post" data-econ-form>
        <div class="card g-span econ-setup">
          <h2>Как устроена экономика</h2>
          <p class="hint" style="margin-top:0">Начните с простой — её хватает большинству серверов. Набор или детальная настройка добавляют новые возможности; их можно выключить в любой момент, деньги участников останутся.</p>
          <div class="econ-modes" role="radiogroup" aria-label="Режим экономики">
            <label class="msg-radio"><input type="radio" name="mode" value="simple" <%= ec.mode === 'simple' ? 'checked' : '' %> /><span><b>Простая</b><small>Монеты, кристаллы, <code>/daily</code>, <code>/pay</code> и магазин. Ничего лишнего.</small></span></label>
            <label class="msg-radio"><input type="radio" name="mode" value="preset" <%= ec.mode === 'preset' ? 'checked' : '' %> /><span><b>Готовый набор</b><small>Выберите набор возможностей и отметьте, какие из них хотите настроить под себя.</small></span></label>
            <label class="msg-radio"><input type="radio" name="mode" value="custom" <%= ec.mode === 'custom' ? 'checked' : '' %> /><span><b>Детально</b><small>Сами включаете нужные разделы и задаёте их числа.</small></span></label>
          </div>

          <div class="econ-pane" data-econ-pane="preset"<%= ec.mode === 'preset' ? '' : ' hidden' %>>
            <h3 class="econ-sub">Набор</h3>
            <div class="econ-presets" role="radiogroup" aria-label="Набор">
              <% ec.PRESETS.forEach((p) => { %>
                <label class="msg-radio"><input type="radio" name="preset" value="<%= p.key %>" <%= ec.preset === p.key ? 'checked' : '' %> /><span><b><%= p.title %></b><small><%= p.desc %></small></span></label>
              <% }) %>
            </div>
            <p class="hint">Отмеченное «Настроить» открывает числа раздела. Неотмеченные разделы работают с обычными значениями.</p>
            <input type="hidden" name="tune__present" value="1" />
          </div>

          <div class="econ-feats" data-econ-pane="preset custom"<%= ec.mode === 'simple' ? ' hidden' : '' %>>
            <% ec.FEATURES.forEach((f) => { const p = ec.params[f.key]; const inPresets = ec.PRESETS.filter((x) => x.features.includes(f.key)).map((x) => x.key).join(' '); const isOn = ec.on.includes(f.key); %>
              <div class="econ-feat<%= isOn ? ' is-on' : '' %>" data-feat="<%= f.key %>" data-in="<%= inPresets %>">
                <div class="ef-head">
                  <div class="ef-text"><b><%= f.title %></b><span><%= f.short %></span></div>
                  <span class="mod-sw sm" data-ef-custom><input type="checkbox" name="f_<%= f.key %>" <%= ec.flags[f.key] === true ? 'checked' : '' %> aria-label="<%= f.title %>" /></span>
                  <% if (f.params.length) { %><label class="ef-tune" data-ef-preset><input type="checkbox" name="tune_<%= f.key %>" checked /> Настроить</label><% } %>
                </div>
                <% if (f.params.length) { %>
                  <div class="ef-params">
                    <% f.params.forEach((q) => { const name = `p_${f.key}_${q.key}`; %>
                      <% if (q.type === 'bool') { %>
                        <label class="rule ef-bool"><span class="rule-text"><b><%= q.label %></b></span><input type="hidden" name="<%= name %>__present" value="1" /><input type="checkbox" name="<%= name %>" <%= p[q.key] ? 'checked' : '' %> /></label>
                      <% } else { %>
                        <div class="fld"><label for="<%= name %>"><%= q.label %><%= q.unit ? ', ' + q.unit : '' %></label><input id="<%= name %>" type="number" name="<%= name %>" value="<%= p[q.key] %>" min="<%= q.min %>" max="<%= q.max %>" /><% if (q.hint) { %><div class="hint"><%= q.hint %></div><% } %></div>
                      <% } %>
                    <% }) %>
                  </div>
                <% } %>
              </div>
            <% }) %>
          </div>
          <p class="econ-simple" data-econ-pane="simple"<%= ec.mode === 'simple' ? '' : ' hidden' %>>Работает только основа. Журнал операций и карточка <code>/balance</code> с графиком есть всегда — они ничего не меняют в правилах.</p>
        </div>

        <% const bev = locals.events || { enabled: true, plan: '' }; %>
        <div class="card g-c2 ev-link-card">
          <h2>События бота</h2>
          <p class="hint" style="margin-top:0">Что даёт: бот сам объявляет на сервере жизнь экономики — карточки общих целей с кнопками «Вложить», их итоги, голосования и розыгрыши казны, конец сезона и новые включённые разделы.</p>
          <% if (!bev.enabled) { %>
            <p class="ev-state off">Модуль «События бота» выключен — цели, голосования и розыгрыши казны не публикуются.</p>
          <% } %>
          <label for="eventsChannelId">Общий канал событий</label>
          <select id="eventsChannelId" name="eventsChannelId">
            <option value="">Не выбран</option>
            <% (locals.channels || []).forEach((c) => { %><option value="<%= c.id %>" <%= settings.economyEventsChannelId === c.id ? 'selected' : '' %>>#<%= c.name %></option><% }) %>
          </select>
          <% if (bev.plan) { %><p class="hint">Новые разделы: <%= bev.plan %>.</p><% } %>
          <a class="card-link" href="/dashboard/<%= guild.id %>/events">Что присылать, куда и в каком порядке — в модуле «События бота» →</a>
        </div>
        <button class="btn" type="submit">Сохранить</button>
      </form>

      <div class="card">
        <h2>Самые богатые</h2>
        <% if (!richest.length || !Number(richest[0].balance)) { %>
          <p class="empty-state">Пока ни у кого нет денег.</p>
        <% } else { %>
          <div class="mini-list">
            <% richest.forEach((p, i) => { const u = users[p.userId] || { name: p.userId, avatar: '' }; %>
              <div class="mini-row"><span class="rk"><%= i + 1 %></span><span class="person"><% if (u.avatar) { %><img src="<%= u.avatar %>" alt="" loading="lazy" /><% } else { %><span class="av-letter" aria-hidden="true"><%= String(u.name || '?').charAt(0).toUpperCase() %></span><% } %><span><%= u.name %></span></span><span class="val"><%= n(p.balance) %> · <%= n(p.crystals) %> кр.</span></div>
            <% }) %>
          </div>
        <% } %>
        <a class="card-link" href="/dashboard/<%= guild.id %>/economy-journal">Журнал всех операций →</a>
      </div>

      <form method="post" action="/dashboard/<%= guild.id %>/economy/grant" class="card set-tools" id="grant" data-no-guard data-confirm="Изменить баланс участника? Вернуть прежнее значение можно только обратной операцией." data-confirm-ok="Изменить" data-confirm-soft>
        <h2>Начислить или списать вручную</h2>
        <div class="fld">
          <label>ID участника</label>
          <input type="text" name="userId" inputmode="numeric" placeholder="Например, 123456789012345678" required pattern="[0-9]{15,25}" />
          <div class="hint">Включите режим разработчика в Discord, правый клик по участнику → «Копировать ID».</div>
        </div>
        <div class="fld-pair">
          <div class="fld fld-inline">
            <label>Что</label>
            <select name="currency"><option value="coins"><%= settings.currencyName %></option><option value="crystals"><%= settings.crystalName %></option></select>
          </div>
          <div class="fld fld-inline">
            <label>Сколько (минус — забрать)</label>
            <input type="number" name="amount" value="100" required />
          </div>
        </div>
        <button class="btn" type="submit">Применить</button>
      </form>
    </main>
  </div>
  <script src="/js/economy.js?v=<%= typeof assetV !== 'undefined' ? assetV : '' %>" defer></script>
</body>
</html>
