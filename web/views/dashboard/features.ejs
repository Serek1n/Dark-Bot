<!DOCTYPE html>
<html lang="ru">
<head><%- include('../partials/head', { title: guild.name + ' — Модули' }) %></head>
<body>
  <div class="app-layout with-nav">
    <%- include('../partials/sidebar') %>
    <main class="content <%= (locals.M || global.__darkModules).layoutOf(locals.active) %>" id="main" tabindex="-1">
      <div class="page-header">
        <h1>Модули</h1>
        <p class="page-intro">Включайте только то, что нужно серверу. Переключатель срабатывает сразу: выключенный модуль перестаёт работать и пропадает из работающих, а все его настройки и данные сохраняются — после включения всё вернётся как было.</p>
      </div>
      <% const M = locals.M || global.__darkModules; const mods = locals.mods || M.moduleState(settings); %>
      <%
        // two columns of equal height: the groups are split so that the counts of rows on both sides are closest
        // (each group keeps its place inside its column; on narrow screens the columns simply stack)
        const weights = mods.groups.map((g) => g.modules.length + 2);
        let best = 0; let bestDiff = Infinity;
        for (let mask = 0; mask < (1 << weights.length); mask++) {
          if (!(mask & 1)) continue; // the first group always on the left
          const left = weights.reduce((n, w, i) => n + (mask & (1 << i) ? w : 0), 0);
          const diff = Math.abs(2 * left - weights.reduce((a, b) => a + b, 0));
          if (diff < bestDiff) { bestDiff = diff; best = mask; }
        }
        const cols = [mods.groups.filter((g, i) => best & (1 << i)), mods.groups.filter((g, i) => !(best & (1 << i)))];
      %>
      <div class="mods-cols g-span">
      <% cols.forEach((col) => { %><div class="mods-col">
      <% col.forEach((g) => { %>
        <section class="card mods-group">
          <h2><%= g.title %> <small><%= g.modules.filter((m) => m.on).length %> из <%= g.modules.length %></small></h2>
          <% g.modules.forEach((m) => { const cmds = (m.commands || []).filter((c) => !/[A-Z]/.test(c)); %>
            <div class="mods-row<%= m.on ? ' is-on' : ' is-off' %>" data-mod-row="<%= m.key %>">
              <span class="mh-icon<%= m.on ? ' is-on' : '' %>"><%- M.icon(m.key, 18) %></span>
              <div class="mods-main">
                <div class="mods-title"><%= m.title %><% if (m.depends.length) { %> <span class="mods-dep">нужна «<%= m.depends.map((d) => (mods.list.find((x) => x.key === d) || {}).title).join('», «') %>»</span><% } %></div>
                <div class="mods-desc"><%= m.desc %></div>
                <% if (cmds.length) { %><div class="mods-cmds"><% cmds.forEach((c) => { %><code>/<%= c %></code><% }) %></div><% } %>
                <% (m.parts || []).forEach((sec) => { %>
                  <div class="mods-section" data-mod-row="<%= sec.key %>"><span>Раздел «<%= sec.title %>»</span><label class="mod-sw sm"><input type="checkbox" data-mod-switch="<%= sec.key %>" data-mod-title="<%= sec.title %>"<%= sec.on ? ' checked' : '' %> aria-label="<%= sec.title %>"></label></div>
                <% }) %>
              </div>
              <% if (m.page) { %><a class="mods-open" href="/dashboard/<%= guild.id %>/<%= m.page %>">Настроить ›</a><% } %>
              <% if (m.switchable) { %>
                <label class="mod-sw" title="<%= m.on ? 'Выключить модуль' : 'Включить модуль' %>"><input type="checkbox" data-mod-switch="<%= m.key %>" data-mod-title="<%= m.title %>"<%= m.on ? ' checked' : '' %> aria-label="<%= m.title %>"></label>
              <% } else { %><span class="mod-core" title="Этот модуль нельзя выключить">всегда</span><% } %>
            </div>
          <% }) %>
        </section>
      <% }) %>
      </div><% }) %>
      </div>
      <section class="card mods-group mods-system">
        <h2><%= mods.system.title %></h2>
        <% mods.system.modules.forEach((m) => { %>
          <div class="mods-row is-on">
            <span class="mh-icon is-on"><%- M.icon(m.key, 18) %></span>
            <div class="mods-main"><div class="mods-title"><%= m.title %></div><div class="mods-desc"><%= m.desc %></div></div>
            <a class="mods-open" href="/dashboard/<%= guild.id %>/<%= m.page %>">Открыть ›</a>
          </div>
        <% }) %>
      </section>
    </main>
  </div>
</body>
</html>
