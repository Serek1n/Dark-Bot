<!DOCTYPE html>
<html lang="ru">
<head><%- include('../partials/head', { title: guild.name + ' — Автороль и возврат' }) %></head>
<body>
  <div class="app-layout with-nav">
    <%- include('../partials/sidebar') %>
    <main class="content <%= (locals.M || global.__darkModules).layoutOf(locals.active) %>" id="main" tabindex="-1">
      <div class="page-header">
        <%- include('../partials/module-head') %>
        <h1>Автороль и возвращение участника</h1>
        <p class="page-intro">Роль, которую новичок получает при входе, и что бот возвращает человеку, который вышел и зашёл снова.</p>
      </div>
      <% const A = locals.A || (() => ''); const autoRole = settings.autoRoleId ? roles.find(r => r.id === settings.autoRoleId) : null; %>
      <form method="post" class="set-page" data-api="welcome.rejoin">
        <section class="card set-section">
          <h2>Автороль</h2>
          <div class="set-row">
            <div class="set-text"><label for="autoRoleId">Роль новичкам</label><p class="set-help">Бот выдаёт её каждому, кто заходит на сервер. Роли выше роли бота в списке недоступны</p></div>
            <div class="set-ctl"><select id="autoRoleId" name="autoRoleId">
              <option value="">Не выдавать</option>
              <% roles.forEach(r => { %>
                <option value="<%= r.id %>" <%= settings.autoRoleId === r.id ? 'selected' : (r.blocked ? 'disabled' : '') %>>@<%= r.name %><%= r.blocked ? ' — ' + r.blocked : '' %></option>
              <% }) %>
              <% if (settings.autoRoleId && !autoRole) { %><option value="<%= settings.autoRoleId %>" selected data-gone="role">⚠️ Удалённая роль (ID: <%= settings.autoRoleId %>)</option><% } %>
            </select></div>
            <% if (autoRole && autoRole.blocked) { %><div class="gone-note" role="note">⚠️ Эту роль бот выдать не сможет: <%= autoRole.blocked %>. Поднимите роль бота выше в настройках сервера.</div><% } %>
          </div>
        </section>

        <section class="card set-section">
          <h2>Возвращение участника</h2>
          <p class="set-lead">Уровень, опыт, монеты, кристаллы, покупки и предупреждения при выходе не удаляются никогда. Здесь — что ещё вернуть.</p>
          <div class="set-row">
            <div class="set-text"><label for="restoreOnRejoin">Возвращать роли и никнейм</label><p class="set-help">Не возвращаются роли выше роли бота, роли ботов и бустеров. После разбана участник возвращается без ролей</p></div>
            <div class="set-ctl"><input type="checkbox" class="switch" id="restoreOnRejoin" name="restoreOnRejoin" <%= settings.restoreOnRejoin !== false ? 'checked' : '' %> /></div>
          </div>
          <div class="set-row" data-depends="restoreOnRejoin">
            <div class="set-text"><label for="restoreDays">Сколько помнить ушедшего</label><p class="set-help">Не больше года: дольше данные ушедшего не хранятся</p></div>
            <div class="set-ctl"><input type="number" id="restoreDays" name="restoreDays" value="<%= Math.min(settings.restoreDays || 365, 365) %>" <%- A('welcome.rejoin', 'restoreDays') %> /><span class="set-unit">дней</span></div>
          </div>
          <div class="set-row" data-depends="restoreOnRejoin">
            <div class="set-text"><label for="restoreStaffRoles">Возвращать и роли модераторов</label><p class="set-help">Роли с правами модератора или администратора. По умолчанию их выдают заново вручную</p></div>
            <div class="set-ctl"><input type="checkbox" class="switch" id="restoreStaffRoles" name="restoreStaffRoles" <%= settings.restoreStaffRoles ? 'checked' : '' %> /></div>
          </div>
          <div class="set-actions">
            <button class="btn" type="submit">Сохранить</button>
            <button class="btn btn-secondary set-reset" type="button" data-reset-section="welcome.rejoin">Сбросить к стандартным</button>
          </div>
        </section>
      </form>
    </main>
  </div>
</body>
</html>
