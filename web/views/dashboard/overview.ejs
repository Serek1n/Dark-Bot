<!DOCTYPE html>
<html lang="ru">
<head><%- include('../partials/head', { title: guild.name + ' — Обзор' }) %></head>
<body>
  <div class="app-layout">
    <%- include('../partials/sidebar') %>
    <main class="content" id="main" tabindex="-1">
      <%# The home: every module on the left with its number; on the right the chosen one (?m=key) or the server summary. %>
      <% const M = locals.M || global.__darkModules; const fmtN = (v) => Number(v || 0).toLocaleString('ru-RU').replace(/\s/g, '\u202f');
         const mods = locals.mods || M.moduleState(settings); const stats = locals.stats || {}; const selected = locals.selected || null;
         const sel = selected ? mods.list.find((m) => m.key === selected) : null; %>
      <% const initial = String(guild.name || '?').trim().charAt(0).toUpperCase(); const online = locals.sys ? sys.botOnline : null; %>
      <div class="home-head">
        <% if (guild.icon) { %><img class="hh-icon" src="https://cdn.discordapp.com/icons/<%= guild.id %>/<%= guild.icon %>.png" alt="" data-initial="<%= initial %>" />
        <% } else { %><span class="hh-icon guild-initial" aria-hidden="true"><%= initial %></span><% } %>
        <div class="hh-text">
          <h1><%= guild.name %></h1>
          <div class="hh-chips">
            <% if (guild.approximate_member_count) { %><span class="hh-chip"><b><%= fmtN(guild.approximate_member_count) %></b> участников</span><% } %>
            <% if (online !== null) { %><span class="hh-chip <%= online ? 'ok' : 'bad' %>"><i></i><%= online ? 'Бот в сети' : 'Бот не в сети' %></span><% } %>
            <a class="hh-chip" href="/dashboard/<%= guild.id %>/features">Модулей включено: <b><%= mods.on %></b> из <%= mods.total %></a>
          </div>
        </div>
      </div>
      <div class="home-split">
        <nav class="home-list" aria-label="Модули">
          <a class="hl-row hl-home<%= sel ? '' : ' sel' %>" href="/dashboard/<%= guild.id %>"<%- sel ? '' : ' aria-current="page"' %>><span class="hl-ico"><%- M.icon('home', 15) %></span><span class="hl-name">Сводка по серверу</span></a>
          <% mods.groups.forEach((g) => { %>
            <div class="hl-cat"><%= g.title %></div>
            <% g.modules.forEach((m) => { const st = stats[m.key]; %>
              <a class="hl-row<%= m.on ? ' is-on' : ' is-off' %><%= sel && sel.key === m.key ? ' sel' : '' %>" data-mod-row="<%= m.key %>" href="/dashboard/<%= guild.id %>?m=<%= m.key %>"<%- sel && sel.key === m.key ? ' aria-current="page"' : '' %>>
                <span class="hl-ico"><%- M.icon(m.key, 15) %></span><span class="hl-name"><%= m.title %></span>
                <% if (m.on && st && st[0]) { %><span class="hl-num"><%= fmtN(st[0].value) %></span><% } %>
                <i class="hl-dot" aria-label="<%= m.on ? 'включён' : 'выключен' %>"></i>
              </a>
            <% }) %>
          <% }) %>
        </nav>

        <section class="home-pane" aria-live="polite">
        <% if (sel) { const st = stats[sel.key] || []; const cmds = (sel.commands || []).filter((c) => !/[A-Z]/.test(c)); %>
          <a class="hp-back" href="/dashboard/<%= guild.id %>">‹ Сводка по серверу</a>
          <div class="hp-head">
            <span class="mh-icon<%= sel.on ? ' is-on' : '' %>"><%- M.icon(sel.key, 22) %></span>
            <div class="hp-title"><h2><%= sel.title %></h2><p><%= sel.desc %></p></div>
            <div class="mh-side">
              <% if (sel.switchable) { %>
                <span class="mh-pill<%= sel.on ? '' : ' off' %>" data-mod-pill="<%= sel.key %>"><%= sel.on ? 'Включён' : 'Выключен' %></span>
                <label class="mod-sw" title="<%= sel.on ? 'Выключить модуль' : 'Включить модуль' %>"><input type="checkbox" data-mod-switch="<%= sel.key %>" data-mod-title="<%= sel.title %>" data-mod-reload<%= sel.on ? ' checked' : '' %> aria-label="<%= sel.title %>"></label>
              <% } else { %><span class="mh-pill">Всегда включён</span><% } %>
            </div>
          </div>
          <% if (st.length) { %>
            <div class="hp-stats"><% st.forEach((x) => { %><div><b><%= fmtN(x.value) %></b><span><%= x.label %></span></div><% }) %></div>
          <% } %>
          <% if (cmds.length) { %>
            <div class="hp-sec">Команды в Discord</div>
            <div class="hp-cmds"><% cmds.forEach((c) => { %><code>/<%= c %></code><% }) %></div>
          <% } %>
          <% if (sel.depends.length) { %>
            <div class="hp-sec">Нужен для работы</div>
            <div class="hp-cmds"><% sel.depends.forEach((d) => { const dm = mods.list.find((x) => x.key === d); %><a href="/dashboard/<%= guild.id %>?m=<%= d %>"><%= dm ? dm.title : d %></a><% }) %></div>
          <% } %>
          <div class="hp-acts">
            <% if (sel.page) { %>
              <a class="btn" href="/dashboard/<%= guild.id %>/<%= sel.page %>">Открыть настройки модуля</a>
              <% sel.pages.slice(1).filter((p) => M.PAGE_LABELS[p] && !mods.list.some((o) => o.page === p)).forEach((p) => { %><a class="btn btn-secondary" href="/dashboard/<%= guild.id %>/<%= p %>"><%= M.PAGE_LABELS[p] %></a><% }) %>
            <% } else { %>
              <p class="hint">У этого модуля нет настроек в панели: он работает командами в Discord.</p>
            <% } %>
          </div>
        <% } else { %>
          <% const att = locals.attention || []; %>
          <% if (att.length) { %>
          <div class="card hp-attn">
            <h2>Требует внимания <span class="hp-attn-n"><%= att.length %></span></h2>
            <div class="hp-attn-list">
              <% att.forEach((a) => { %><a class="hp-attn-row <%= a.level %>" href="<%= a.href %>"><span class="hp-attn-ico"><%- M.icon(a.icon, 15) %></span><span class="hp-attn-text"><%= a.text %></span><span class="hp-attn-go" aria-hidden="true">›</span></a><% }) %>
            </div>
          </div>
          <% } %>
          <div class="stat-row hp-kpis">
            <div class="stat-box"><div class="value"><%= guild.approximate_member_count ? fmtN(guild.approximate_member_count) : '—' %></div><div class="label">Участников на сервере</div></div>
            <div class="stat-box"><div class="value"><%= fmtN(memberCount) %></div><div class="label">В системе уровней</div></div>
            <div class="stat-box"><div class="value"><%= fmtN(warningCount) %></div><div class="label">Предупреждений</div></div>
            <div class="stat-box"><div class="value"><%= mods.on %>/<%= mods.total %></div><div class="label">Модулей включено</div></div>
          </div>
      <%
        const actionRu = { warn: 'Предупреждение', unwarn: 'Снято предупреждение', mute: 'Мут', unmute: 'Размут', kick: 'Кик', ban: 'Бан', unban: 'Разбан', clear: 'Очистка', automod: 'Автомодерация', note: 'Заметка' };
        const ago = (d) => { const m = Math.max(0, Math.round((Date.now() - new Date(d).getTime()) / 60000)); if (m < 1) return 'только что'; if (m < 60) return m + ' мин назад'; const h = Math.round(m / 60); if (h < 24) return h + ' ч назад'; return Math.round(h / 24) + ' дн назад'; };
      %>
      <div class="grid-2">
        <div class="card">
          <h2>Топ по опыту</h2>
          <% if (!topMembers.length) { %>
            <p class="empty-state">Пока никто не заработал опыт.</p>
          <% } else { %>
            <div class="mini-list">
              <% topMembers.forEach((p, i) => { const u = users[p.userId] || { name: p.userId, avatar: '' }; %>
                <div class="mini-row"><span class="rk"><%= i + 1 %></span><span class="person"><img src="<%= u.avatar %>" alt="" loading="lazy" /><span><%= u.name %></span></span><span class="val">ур. <%= p.level %></span></div>
              <% }) %>
            </div>
            <a class="card-link" href="/dashboard/<%= guild.id %>/leaderboard">Весь лидерборд →</a>
          <% } %>
        </div>
        <div class="card">
          <h2>Последние действия модераторов</h2>
          <% if (!recentLogs.length) { %>
            <p class="empty-state">Действий пока нет.</p>
          <% } else { %>
            <div class="mini-list">
              <% recentLogs.forEach(l => { const u = users[l.userId] || { name: l.userId, avatar: '' }; %>
                <div class="mini-row"><span class="badge badge-<%= l.action %>"><%= actionRu[l.action] || l.action %></span><span class="person"><img src="<%= u.avatar %>" alt="" loading="lazy" /><span><%= u.name %></span></span><span class="when"><%= ago(l.createdAt) %></span></div>
              <% }) %>
            </div>
            <a class="card-link" href="/dashboard/<%= guild.id %>/moderation">Весь журнал →</a>
          <% } %>
        </div>
      </div>

      <div class="card">
        <h2>
          <svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="4" width="15" height="12" rx="1.5"/><path d="M5.5 8L8 10L5.5 12M10.5 12.5H14.5"/></svg>
          Команды бота
        </h2>
        <p class="hp-cmd-intro">Настройки сервера делаются только здесь, в панели. В Discord остались команды для участников и модераторов:</p>
        <div class="cmd-grid hp-cmd-grid">
          <div><code>/profile</code><br>Карточка: уровень, место, баланс</div>
          <div><code>/top</code><br>Лидеры: общий и по голосу</div>
          <div><code>/play</code><br>Музыка, управление кнопками</div>
          <div><code>/daily</code> <code>/balance</code> <code>/pay</code><br>Награда, баланс и переводы</div>
          <div><code>/shop</code><br>Магазин: роли и предметы за валюту</div>
          <div><code>/mod</code><br>Наказания, дела и история, очистка, замок канала</div>
          <div><code>/help</code><br>Подсказка по ролям</div>
        </div>
        <p>Префикс своих текстовых команд: <code><%= settings.prefix %></code></p>
      </div>

      <% if (locals.sys) { %>
      <div class="card" id="system">
        <h2>
          <svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="10" cy="10" r="7.5"/><path d="M10 9V14M10 6.2V6.3"/></svg>
          О версии
        </h2>
        <div class="sys-grid">
          <div><small>Бот</small><b>v<%= sys.bot %></b><span class="sys-state <%= sys.botOnline ? 'on' : 'off' %>"><%= sys.botOnline ? 'в сети' + (sys.ping !== null ? ' · ' + sys.ping + ' мс' : '') : 'не в сети' %></span></div>
          <div><small>Веб-панель</small><b>v<%= sys.panel %></b><span class="sys-state on">работает</span></div>
        </div>
        <a class="card-link" href="/dashboard/<%= guild.id %>/changelog">Что нового →</a>
      </div>
      <% } %>
        <% } %>
        </section>
      </div>
    </main>
  </div>
</body>
</html>
