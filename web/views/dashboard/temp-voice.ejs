<!DOCTYPE html>
<html lang="ru">
<head><%- include('../partials/head', { title: guild.name + ' — Временные голосовые' }) %></head>
<body>
  <div class="app-layout">
    <%- include('../partials/sidebar') %>
    <main class="content" id="main" tabindex="-1">
      <div class="page-header">
        <%- include('../partials/module-head') %>
        <h1>Временные голосовые</h1>
        <p class="page-intro">Личные комнаты: участник заходит в канал-создатель — бот создаёт ему комнату, переносит в неё и делает владельцем; пустая комната удаляется. Сюда же входят голосовые роли — они работают в любых голосовых каналах.</p>
      </div>
      <% const g = '/dashboard/' + guild.id; const chName = (id) => { const c = channels.find((x) => x.id === id); return c ? c.name : null; }; %>
      <div class="stat-row four">
        <div class="stat-box"><div class="value"><%= rooms.length %></div><div class="label">Комнат сейчас</div></div>
        <a class="stat-box" href="<%= g %>/temp-voice-rooms"><div class="value"><%= (settings.tempVoiceJoinChannelId ? 1 : 0) + triggers.length %></div><div class="label">Каналов-создателей</div></a>
        <a class="stat-box" href="<%= g %>/temp-voice-roles"><div class="value"><%= voiceRoleCount %></div><div class="label">Голосовых ролей</div></a>
        <a class="stat-box" href="<%= g %>/temp-voice-panel"><div class="value"><%= settings.tempVoicePanelMessageId ? '✓' : '—' %></div><div class="label">Панель управления</div></a>
      </div>
      <% if (!settings.tempVoiceJoinChannelId) { %>
        <div class="card g-span mod-alert"><p style="margin:0"><b>Канал-создатель не выбран</b> — комнаты не создаются. <a href="<%= g %>/temp-voice-rooms">Выбрать →</a></p></div>
      <% } %>
      <div class="card g-span">
        <h2>Комнаты сейчас</h2>
        <% if (!rooms.length) { %>
          <p class="empty-state">Сейчас комнат нет. Зайдите в канал-создатель<%= settings.tempVoiceJoinChannelId && chName(settings.tempVoiceJoinChannelId) ? ' «' + chName(settings.tempVoiceJoinChannelId) + '»' : '' %>, чтобы проверить.</p>
        <% } else { %>
          <div class="table-scroll"><table>
            <thead><tr><th>Комната</th><th>Владелец</th><th>Доступ</th><th>Создана</th></tr></thead>
            <tbody>
              <% rooms.forEach((r) => { const u = users[r.ownerId] || { name: r.ownerId, avatar: '' }; %>
                <tr>
                  <td>🔊 <%= chName(r.channelId) || r.channelId %></td>
                  <td class="nowrap"><span class="person"><img src="<%= u.avatar %>" alt="" loading="lazy" /><span><%= u.name %></span></span></td>
                  <td><%= { open: 'Открыта', locked: 'Закрыта', hidden: 'Скрыта' }[r.access] || r.access %></td>
                  <td class="nowrap"><%= new Date(r.createdAt).toLocaleString('ru-RU', { day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit' }) %></td>
                </tr>
              <% }) %>
            </tbody>
          </table></div>
        <% } %>
      </div>
    </main>
  </div>
</body>
</html>
