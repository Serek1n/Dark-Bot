<!DOCTYPE html>
<html lang="ru">
<head><%- include('../partials/head', { title: guild.name + ' — Модерация' }) %></head>
<body>
  <div class="app-layout">
    <%- include('../partials/sidebar') %>
    <div class="content">
      <div class="page-header">
        <h1>Модерация</h1>
        <p class="page-intro">Куда бот публикует действия модераторов и куда попадают жалобы участников.</p>
      </div>

      <form method="post" class="card">
        <h2>Каналы</h2>
        <div>
          <label>Канал журнала модерации</label>
          <select name="modLogChannelId">
            <option value="">— не выбрано —</option>
            <% channels.filter(c => c.type === 0).forEach(c => { %>
              <option value="<%= c.id %>" <%= settings.modLogChannelId === c.id ? 'selected' : '' %>>#<%= c.name %></option>
            <% }) %>
          </select>
        </div>
        <div>
          <label>Канал для жалоб участников (контекстное меню "Пожаловаться")</label>
          <select name="reportChannelId">
            <option value="">— не выбрано —</option>
            <% channels.filter(c => c.type === 0).forEach(c => { %>
              <option value="<%= c.id %>" <%= settings.reportChannelId === c.id ? 'selected' : '' %>>#<%= c.name %></option>
            <% }) %>
          </select>
        </div>
        <button class="btn" type="submit">Сохранить</button>
      </form>

      <div class="card">
        <h2>Последние действия (50)</h2>
        <% if (!logs.length) { %>
          <p class="empty-state"><svg width="26" height="26" viewBox="0 0 20 20" fill="currentColor"><path d="M13 3.5C10.5 4.8 8.8 7.3 8.8 10.2C8.8 13.1 10.5 15.6 13 16.9C11.6 17.8 9.9 18.3 8.1 18.3C3.6 18.3 0 14.5 0 10C0 5.5 3.6 1.7 8.1 1.7C9.9 1.7 11.6 2.2 13 3.5Z"/></svg>Действий пока нет.</p>
        <% } else { %>
          <table>
            <thead><tr><th>Действие</th><th>Участник</th><th>Модератор</th><th>Причина</th><th>Дата</th></tr></thead>
            <tbody>
              <% logs.forEach(l => { %>
                <tr>
                  <td><span class="badge badge-<%= l.action %>"><%= l.action %></span></td>
                  <td><code><%= l.userId %></code></td>
                  <td><code><%= l.moderatorId %></code></td>
                  <td><%= l.reason %></td>
                  <td><%= new Date(l.createdAt).toLocaleString('ru-RU') %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } %>
      </div>
    </div>
  </div>
</body>
</html>
