<!DOCTYPE html>
<html lang="ru">
<head><%- include('../partials/head', { title: guild.name + ' — Наказания' }) %></head>
<body>
  <div class="app-layout">
    <%- include('../partials/sidebar') %>
    <main class="content" id="main" tabindex="-1">
      <div class="page-header">
        <%- include('../partials/module-head') %>
        <h1>Наказания</h1>
        <p class="page-intro">Предупреждения, муты, кики и баны, автоматические наказания и жалобы участников — в одном месте. Наказывают модераторы командой <code>/mod</code> в Discord, автомодерация и правила за предупреждения — сами.</p>
      </div>
      <% const g = '/dashboard/' + guild.id; const n = (v) => Number(v || 0).toLocaleString('ru-RU'); %>
      <div class="stat-row four">
        <a class="stat-box" href="<%= g %>/moderation-warnings"><div class="value"><%= n(stats.warns) %></div><div class="label">Действующих предупреждений</div></a>
        <a class="stat-box" href="<%= g %>/moderation-log"><div class="value"><%= n(stats.cases7) %></div><div class="label">Действий за неделю</div></a>
        <a class="stat-box" href="<%= g %>/moderation-reports"><div class="value"><%= n(stats.openReports) %></div><div class="label">Новых жалоб</div></a>
        <a class="stat-box" href="<%= g %>/moderation-punishments"><div class="value"><%= n(stats.tempBans) %></div><div class="label">Временных банов идёт</div></a>
      </div>
      <% if (stats.failedAuto) { %>
        <div class="card g-span mod-alert"><p style="margin:0"><b>За неделю не сработало автонаказаний: <%= stats.failedAuto %>.</b> Причина у каждого записана — <a href="<%= g %>/moderation-warnings?auto=failed">посмотреть</a>. Чаще всего роль участника выше роли бота или у него право «Администратор».</p></div>
      <% } %>

      <div class="card g-c1">
        <h2>Готовность бота<span class="sub">Без этих прав и без роли выше наказуемых автонаказания не сработают</span></h2>
        <%- include('../partials/bot-ready') %>
      </div>
      <div class="card g-c2">
        <h2>Правила за предупреждения</h2>
        <% if (thresholds.length) { %>
          <div class="mini-list">
            <% thresholds.forEach((t) => { %><div class="mini-row"><span class="rk"><%= t.count %></span><span class="person"><span>предупреждений →</span></span><b><%= t.action === 'mute' ? 'мут на ' + formatDuration(t.minutes * 60000) : t.action === 'kick' ? 'кик' : t.minutes ? 'бан на ' + formatDuration(t.minutes * 60000) : 'бан навсегда' %></b></div><% }) %>
          </div>
        <% } else { %>
          <p class="empty-state">Правил нет: бот только записывает предупреждения.</p>
        <% } %>
        <a class="card-link" href="<%= g %>/moderation-auto">Настроить автонаказания →</a>
      </div>
      <div class="card g-c1">
        <h2>Последние действия</h2>
        <% if (!recent.length) { %>
          <p class="empty-state">Наказаний пока не было.</p>
        <% } else { %>
          <div class="mini-list">
            <% const actionRu = { warn: 'Предупреждение', unwarn: 'Снято предупреждение', mute: 'Мут', unmute: 'Размут', kick: 'Кик', ban: 'Бан', unban: 'Разбан', clear: 'Очистка', automod: 'Автомодерация', note: 'Заметка' }; %>
            <% recent.forEach((l) => { const u = users[l.userId] || { name: l.userId, avatar: '' }; %>
              <div class="mini-row"><span class="badge badge-<%= l.action %>"><%= actionRu[l.action] || l.action %></span><span class="person"><% if (u.avatar) { %><img src="<%= u.avatar %>" alt="" loading="lazy" /><% } else { %><span class="av-letter" aria-hidden="true"><%= String(u.name || '?').charAt(0).toUpperCase() %></span><% } %><span><%= u.name %></span></span><span class="val">#<%= l.caseNumber || '—' %></span></div>
            <% }) %>
          </div>
        <% } %>
        <a class="card-link" href="<%= g %>/moderation-log">Весь журнал →</a>
      </div>
      <div class="card g-c2">
        <h2>Новые жалобы</h2>
        <% if (!reports.length) { %>
          <p class="empty-state">Новых жалоб нет.</p>
        <% } else { %>
          <div class="mini-list">
            <% reports.forEach((r) => { const t = users[r.targetId] || { name: r.targetId, avatar: '' }; %>
              <div class="mini-row"><span class="rk">#<%= r.id %></span><span class="person"><% if (t.avatar) { %><img src="<%= t.avatar %>" alt="" loading="lazy" /><% } else { %><span class="av-letter" aria-hidden="true"><%= String(t.name || '?').charAt(0).toUpperCase() %></span><% } %><span><%= t.name %></span></span><span class="val"><%= new Date(r.createdAt).toLocaleDateString('ru-RU') %></span></div>
            <% }) %>
          </div>
        <% } %>
        <a class="card-link" href="<%= g %>/moderation-reports">Все жалобы →</a>
      </div>
    </main>
  </div>
</body>
</html>
