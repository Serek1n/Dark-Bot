<!DOCTYPE html>
<html lang="ru">
<head><%- include('../partials/head', { title: guild.name + ' — Роли по реакциям' }) %></head>
<body>
  <div class="app-layout">
    <%- include('../partials/sidebar') %>
    <div class="content">
      <div class="page-header">
        <h1>Роли по реакциям</h1>
        <p class="page-intro">Участник получает роль, поставив реакцию на сообщение — и теряет её, убрав реакцию.</p>
      </div>
      <form method="post" class="card">
        <h2>Новая привязка</h2>
        <div>
          <label>Канал с сообщением</label>
          <select name="channelId" required>
            <% channels.filter(c => c.type === 0 || c.type === 5).forEach(c => { %>
              <option value="<%= c.id %>">#<%= c.name %></option>
            <% }) %>
          </select>
        </div>
        <div>
          <label>ID сообщения</label>
          <input type="text" name="messageId" inputmode="numeric" placeholder="Правый клик по сообщению → Копировать ID" required />
        </div>
        <div>
          <label>Эмодзи</label>
          <input type="text" name="emoji" placeholder="😀 или &lt;:имя:123456789&gt;" required />
        </div>
        <div>
          <label>Роль</label>
          <select name="roleId" required>
            <% roles.forEach(r => { %>
              <option value="<%= r.id %>" <%= r.blocked ? 'disabled' : '' %>>@<%= r.name %><%= r.blocked ? ' — ' + r.blocked : '' %></option>
            <% }) %>
          </select>
        </div>
        <div class="two-col">
          <% for (let k = 0; k < 2; k++) { %>
          <div>
            <label>Ещё роль (необязательно)</label>
            <select name="extraRoleId">
              <option value="">—</option>
              <% roles.forEach(r => { %><option value="<%= r.id %>" <%= r.blocked ? 'disabled' : '' %>>@<%= r.name %></option><% }) %>
            </select>
          </div>
          <% } %>
        </div>
        <div>
          <label>Режим</label>
          <select name="mode">
            <option value="normal">Обычный: реакция выдаёт роли, снятие реакции — забирает</option>
            <option value="single">Одна из сообщения: новая реакция снимает роли других реакций этого сообщения</option>
            <option value="reverse">Обратный: реакция забирает роли, снятие реакции — возвращает</option>
          </select>
        </div>
        <button class="btn" type="submit">Добавить</button>
      </form>
      <div class="card">
        <% if (!reactionRoles.length) { %>
          <p class="empty-state"><svg width="26" height="26" viewBox="0 0 20 20" fill="currentColor"><path d="M13 3.5C10.5 4.8 8.8 7.3 8.8 10.2C8.8 13.1 10.5 15.6 13 16.9C11.6 17.8 9.9 18.3 8.1 18.3C3.6 18.3 0 14.5 0 10C0 5.5 3.6 1.7 8.1 1.7C9.9 1.7 11.6 2.2 13 3.5Z"/></svg>Привязок пока нет.</p>
        <% } else { %>
          <div class="table-scroll"><table>
            <thead><tr><th>Канал</th><th>ID сообщения</th><th>Эмодзи</th><th>Роль</th><th></th></tr></thead>
            <tbody>
              <% reactionRoles.forEach(rr => {
                const role = roles.find(r => r.id === rr.roleId);
                const channel = channels.find(c => c.id === rr.channelId);
              %>
                <tr>
                  <td>#<%= channel ? channel.name : rr.channelId %></td>
                  <td><%= rr.messageId %></td>
                  <td><%= rr.emoji %></td>
                  <td>@<%= role ? role.name : rr.roleId %><% let ex = []; try { ex = JSON.parse(rr.extraRoleIds || '[]'); } catch (e) {} ex.forEach(id => { const x = roles.find(r => r.id === id); %>, @<%= x ? x.name : id %><% }) %><% if (rr.mode && rr.mode !== 'normal') { %> <span class="badge badge-mute"><%= rr.mode === 'single' ? 'одна из сообщения' : 'обратный' %></span><% } %></td>
                  <td>
                    <form method="post" action="/dashboard/<%= guild.id %>/reaction-roles/delete/<%= rr.id %>">
                      <button class="btn btn-danger" type="submit">Удалить</button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table></div>
        <% } %>
      </div>
    </div>
  </div>
</body>
</html>
