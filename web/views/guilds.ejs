<!DOCTYPE html>
<html lang="ru">
<head><%- include('partials/head', { title: 'Мои серверы' }) %></head>
<body>
  <div class="night-sky"></div>
  <%- include("partials/theme-fab") %>
  <div class="guild-picker" style="position: relative; z-index: 1;">
    <h1>Выберите сервер</h1>
    <p class="subtitle">Серверы, где у вас есть права администратора.</p>
    <% if (!guilds.length) { %>
      <p class="empty-state">У вас нет серверов с правами администратора.</p>
    <% } %>
    <div class="guild-list">
      <% guilds.forEach(g => { %>
        <% if (g.botPresent) { %>
          <a class="guild-card" href="/dashboard/<%= g.id %>">
        <% } else { %>
          <a class="guild-card disabled" href="<%= g.inviteUrl %>" target="_blank" rel="noopener">
        <% } %>
            <% if (g.icon) { %><img src="https://cdn.discordapp.com/icons/<%= g.id %>/<%= g.icon %>.png" alt="" data-initial="<%= String(g.name || '?').trim().charAt(0).toUpperCase() %>" />
            <% } else { %><span class="guild-initial" aria-hidden="true"><%= String(g.name || '?').trim().charAt(0).toUpperCase() %></span><% } %>
            <div>
              <div class="name"><%= g.name %></div>
              <div class="status"><%= g.botPresent ? 'Открыть панель' : (g.daysLeft !== undefined ? 'Бот удалён — настройки сохранены ещё на ' + g.daysLeft + ' дн. Нажмите, чтобы вернуть бота' : 'Бот не добавлен — нажмите, чтобы пригласить') %></div>
            </div>
          </a>
      <% }) %>
    </div>
    <% if (locals.sys) { %><p class="picker-version" title="<%= sysLine %>">Бот v<%= sys.bot %> · Панель v<%= sys.panel %></p><% } %>
  </div>
</body>
</html>
