<%# Panel navigation: groups in the top bar, the pages of the current group as tabs under it; on narrow screens the "≡" button
   opens the full list. One list below feeds all three. %>
<% const navGroups = [
    ["Главное", [["overview", "", "Обзор", "Сводка по серверу", "Обзор — Сводка по серверу", "<rect x=\"3\" y=\"3\" width=\"6\" height=\"6\" rx=\"1.2\"/><rect x=\"11\" y=\"3\" width=\"6\" height=\"6\" rx=\"1.2\"/><rect x=\"3\" y=\"11\" width=\"6\" height=\"6\" rx=\"1.2\"/><rect x=\"11\" y=\"11\" width=\"6\" height=\"6\" rx=\"1.2\"/>"], ["features", "/features", "Функции", "Включение и отключение функций", "Функции — Включение и отключение функций", "<path d=\"M3 6H11M15 6H17M3 14H5M9 14H17\"/><circle cx=\"13\" cy=\"6\" r=\"2\"/><circle cx=\"7\" cy=\"14\" r=\"2\"/>"], ["changelog", "/changelog", "Обновления", "Что нового в боте и панели", "Обновления — Что нового в боте и панели", "<path d=\"M4 9.5H16V16.5H4Z\"/><path d=\"M3 6.5H17V9.5H3Z\"/><path d=\"M10 6.5V16.5M10 6.5C8.5 6.5 6.5 6 6.5 4.5C6.5 3.2 8.5 3 10 6.5ZM10 6.5C11.5 6.5 13.5 6 13.5 4.5C13.5 3.2 11.5 3 10 6.5Z\"/>"]]],
    ["Сообщество", [["leveling", "/leveling", "Уровни", "Опыт и очки за активность", "Уровни — Опыт и очки за активность", "<path d=\"M3 17V11M9.5 17V7M16 17V3\"/>"], ["level-roles", "/level-roles", "Роли за уровни", "Роли за достигнутый уровень", "Роли за уровни — Роли за достигнутый уровень", "<path d=\"M3.5 16.5V12M8 16.5V8.5M12.5 16.5V5M17 16.5V2.5\"/>"], ["economy", "/economy", "Экономика", "Монеты и кристаллы", "Экономика — Монеты и кристаллы", "<circle cx=\"10\" cy=\"10\" r=\"7\"/><path d=\"M12.4 7.6C12 6.9 11.1 6.5 10 6.5C8.6 6.5 7.6 7.2 7.6 8.2C7.6 10.3 12.4 9.2 12.4 11.8C12.4 12.8 11.4 13.5 10 13.5C8.8 13.5 7.9 13.1 7.5 12.3M10 5V6.5M10 13.5V15\"/>"], ["channel-boosts", "/channel-boosts", "Множители", "Бонусы каналов и ролей", "Множители — бонусы каналов и ролей", "<path d=\"M10.8 2.5L4.5 11H9.7L9.2 17.5L15.5 9H10.3L10.8 2.5Z\"/>"], ["shop", "/shop", "Магазин", "Товары и покупки", "Магазин — Товары и покупки", "<path d=\"M4 7H16L15.2 16H4.8L4 7Z\"/><path d=\"M7.5 7V6C7.5 4.6 8.6 3.5 10 3.5C11.4 3.5 12.5 4.6 12.5 6V7\"/>"], ["leaderboard", "/leaderboard", "Лидерборд", "Рейтинг участников", "Лидерборд — Рейтинг участников", "<path d=\"M6 4H14V9C14 11.2 12.2 13 10 13C7.8 13 6 11.2 6 9V4Z\"/><path d=\"M6 5H3.5C3.5 7 4.5 8 6 8\"/><path d=\"M14 5H16.5C16.5 7 15.5 8 14 8\"/><path d=\"M10 13V16M7 17H13\"/>"], ["giveaways", "/giveaways", "Розыгрыши", "Идущие и завершённые розыгрыши", "Розыгрыши — Идущие и завершённые розыгрыши", "<path d=\"M3.5 8H16.5V11H3.5Z\"/><path d=\"M4.5 11V16.5H15.5V11M10 8V16.5\"/><path d=\"M10 8C8.4 8 6.5 7.4 6.5 5.6C6.5 4.2 8.5 3.900 10 8ZM10 8C11.6 8 13.5 7.4 13.5 5.6C13.5 4.2 11.5 3.900 10 8Z\"/>"], ["starboard", "/starboard", "Доска почёта", "Лучшие сообщения по реакциям", "Доска почёта — Лучшие сообщения по реакциям", "<path d=\"M10 2.5L11.8 7.2L16.8 7.5L12.9 10.6L14.2 15.5L10 12.8L5.8 15.5L7.1 10.6L3.2 7.5L8.2 7.2Z\"/>"]]],
    ["Модерация", [["moderation", "/moderation", "Наказания и журнал", "Предупреждения, муты, баны", "Наказания и журнал — Предупреждения, муты, баны", "<path d=\"M10 2.5L16.5 5V9.5C16.5 13.5 13.7 16.8 10 17.5C6.3 16.8 3.5 13.5 3.5 9.5V5L10 2.5Z\"/>"], ["automod", "/automod", "Автомодерация", "Спам, ссылки, капс", "Автомодерация — Спам, ссылки, капс", "<path d=\"M3 6L10 3L17 6V9C17 13 14 16.5 10 17.5C6 16.5 3 13 3 9V6Z\"/><path d=\"M7.5 9.5L9 11L12.5 7.5\"/>"], ["logs", "/logs", "Логи сервера", "События сервера", "Логи сервера — События сервера", "<path d=\"M5 3H12L15.5 6.5V17H5V3Z\"/><path d=\"M12 3V6.5H15.5M7.5 10H13M7.5 13H11\"/>"]]],
    ["Сервер", [["welcome", "/welcome", "Приветствие", "Приветствие и прощание", "Приветствие — Приветствие и прощание", "<path d=\"M5 17V4.5C5 3.7 5.7 3 6.5 3H12L15 6V17\"/><path d=\"M5 17H15M12 17V3M12 10.2H12.3\"/>"], ["reaction-roles", "/reaction-roles", "Роли по реакциям", "Роли по нажатию на реакцию", "Роли по реакциям — Роли по нажатию на реакцию", "<circle cx=\"10\" cy=\"10\" r=\"7.2\"/><path d=\"M7.3 12C7.9 13 8.9 13.6 10 13.6C11.1 13.6 12.1 13 12.7 12\"/><path d=\"M7.5 8H7.51M12.5 8H12.51\" stroke-width=\"2.2\"/>"], ["interactive", "/interactive", "Интерактивные", "Кнопки и списки с ролями", "Интерактивные — Кнопки и списки с ролями", "<rect x=\"2.5\" y=\"4\" width=\"15\" height=\"12\" rx=\"2\"/><rect x=\"5\" y=\"10\" width=\"4.5\" height=\"3\" rx=\"1\"/><rect x=\"10.5\" y=\"10\" width=\"4.5\" height=\"3\" rx=\"1\"/><path d=\"M5 7H12\"/>"], ["temp-voice", "/temp-voice", "Врем. голосовые", "Личные голосовые комнаты", "Врем. голосовые — Личные голосовые комнаты", "<rect x=\"7.5\" y=\"2.5\" width=\"5\" height=\"8.5\" rx=\"2.5\"/><path d=\"M4.5 9.5C4.5 12.5 7 14.5 10 14.5C13 14.5 15.5 12.5 15.5 9.5M10 14.5V17.5M7 17.5H13\"/>"], ["custom-commands", "/custom-commands", "Кастом-команды", "Свои команды с префиксом", "Кастом-команды — Свои команды с префиксом", "<rect x=\"2.5\" y=\"4\" width=\"15\" height=\"12\" rx=\"1.5\"/><path d=\"M5.5 8L8 10L5.5 12M10.5 12.5H14.5\"/>"], ["alerts", "/alerts", "Оповещения", "Оповещения YouTube и Twitch", "Оповещения — Оповещения YouTube и Twitch", "<path d=\"M5 8C5 5.2 7.2 3 10 3C12.8 3 15 5.2 15 8C15 11.5 16.5 12.5 16.5 13.5H3.5C3.5 12.5 5 11.5 5 8Z\"/><path d=\"M8.3 16C8.6 16.6 9.2 17 10 17C10.8 17 11.4 16.6 11.7 16\"/>"], ["webhooks", "/webhooks", "Вебхуки и сообщения", "Вебхуки, конструктор, расписание", "Вебхуки и сообщения — Вебхуки, конструктор, расписание", "<circle cx=\"6\" cy=\"14\" r=\"2.3\"/><circle cx=\"14\" cy=\"14\" r=\"2.3\"/><circle cx=\"10\" cy=\"5.5\" r=\"2.3\"/><path d=\"M10 7.8L7.2 12M8.3 14H11.7M10 7.8L12.8 12\"/>"]]]
  ];
   const curGroup = navGroups.find((g) => g[1].some((it) => it[0] === active)) || navGroups[0];
   const gi = (s) => `<svg width="17" height="17" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${s}</svg>`;
   const initial = String(guild.name || '?').trim().charAt(0).toUpperCase(); %>
<a class="skip-link" href="#main">Перейти к содержимому</a>
<header class="topbar" id="topbar">
  <div class="tb-row">
    <button type="button" class="tb-icon tb-burger" data-menu-open aria-label="Все разделы" aria-controls="navDrawer" aria-expanded="false">
      <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><path d="M3.5 6h13M3.5 10h13M3.5 14h13"/></svg>
    </button>
    <a href="/dashboard" class="tb-guild" title="Все серверы">
      <% if (guild.icon) { %><img src="https://cdn.discordapp.com/icons/<%= guild.id %>/<%= guild.icon %>.png" alt="" class="guild-icon" data-initial="<%= initial %>" />
      <% } else { %><span class="guild-icon guild-initial" aria-hidden="true"><%= initial %></span><% } %>
      <span class="tb-guild-name"><%= guild.name %></span>
      <svg class="tb-caret" width="14" height="14" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 8l4 4 4-4"/></svg>
    </a>
    <nav class="tb-groups" aria-label="Группы разделов">
      <% navGroups.forEach((g) => { %><a href="/dashboard/<%= guild.id %><%= g[1][0][1] %>" class="tb-group<%= g === curGroup ? ' is-on' : '' %>"<%- g === curGroup ? ' aria-current="true"' : '' %>><%= g[0] %></a><% }) %>
    </nav>
    <div class="tb-actions">
      <button type="button" class="tb-search" data-quick-jump aria-label="Найти раздел или настройку" title="Найти раздел или настройку (Ctrl+K)">
        <svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><circle cx="8.8" cy="8.8" r="5.3"/><path d="M12.8 12.8L16.5 16.5"/></svg>
        <span class="tb-search-text">Поиск</span><kbd class="qj-kbd">Ctrl K</kbd>
      </button>
      <%- include('lang-switch', { cls: 'tb-icon tb-lang', labelCls: 'sr-only' }) %>
      <button type="button" class="tb-icon tb-theme" data-theme-toggle aria-label="Сменить тему" title="Сменить тему">
        <svg class="ic-sun" width="17" height="17" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><circle cx="10" cy="10" r="3.5"/><path d="M10 2.500v2M10 15.500v2M2.500 10h2M15.500 10h2M4.700 4.700l1.400 1.400M13.900 13.900l1.400 1.400M4.700 15.300l1.400-1.400M13.900 6.100l1.400-1.400"/></svg>
        <svg class="ic-moon" width="17" height="17" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16.500 11.500A6.500 6.500 0 118.500 3.500a5.200 5.200 0 008 8z"/></svg>
      </button>
      <% if (typeof user !== 'undefined' && user) { %>
        <details class="tb-user">
          <summary aria-label="Профиль"><img src="<%= user.avatar ? `https://cdn.discordapp.com/avatars/${user.id}/${user.avatar}.png?size=64` : 'https://cdn.discordapp.com/embed/avatars/0.png' %>" alt="" data-fallback="https://cdn.discordapp.com/embed/avatars/0.png" /></summary>
          <div class="tb-user-menu">
            <div class="tb-user-name"><%= user.global_name || user.username %></div>
            <a href="/dashboard">Все серверы</a>
            <% if (locals.sys) { %><a href="/dashboard/<%= guild.id %>/changelog">Бот v<%= sys.bot %> · панель v<%= sys.panel %></a><% } %>
            <form method="post" action="/auth/logout"><button type="submit">Выйти</button></form>
          </div>
        </details>
      <% } %>
    </div>
  </div>
  <nav class="tb-tabs" aria-label="Разделы: <%= curGroup[0] %>">
    <% curGroup[1].forEach((it) => { %><a href="/dashboard/<%= guild.id %><%= it[1] %>" class="tb-tab<%= it[0] === active ? ' is-on' : '' %>"<%- it[0] === active ? ' aria-current="page"' : '' %>><%- gi(it[5]) %><span><%= it[2] %></span></a><% }) %>
  </nav>
</header>

<div class="nav-drawer" id="navDrawer" hidden>
  <div class="nd-backdrop" data-menu-close></div>
  <aside class="nd-panel" role="dialog" aria-modal="true" aria-label="Все разделы">
    <div class="nd-head">
      <a href="/dashboard" class="tb-guild" title="Все серверы">
        <% if (guild.icon) { %><img src="https://cdn.discordapp.com/icons/<%= guild.id %>/<%= guild.icon %>.png" alt="" class="guild-icon" data-initial="<%= initial %>" />
        <% } else { %><span class="guild-icon guild-initial" aria-hidden="true"><%= initial %></span><% } %>
        <span class="tb-guild-name"><%= guild.name %></span>
      </a>
      <button type="button" class="tb-icon" data-menu-close aria-label="Закрыть меню">
        <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M5 5l10 10M15 5L5 15"/></svg>
      </button>
    </div>
    <button type="button" class="nd-search" data-quick-jump>
      <svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><circle cx="8.8" cy="8.8" r="5.3"/><path d="M12.8 12.8L16.5 16.5"/></svg>
      Найти раздел или настройку
    </button>
    <nav class="nd-nav" aria-label="Меню панели">
      <% navGroups.forEach((g) => { %>
        <div class="nd-group">
          <div class="nd-group-label"><%= g[0] %></div>
          <% g[1].forEach((it) => { %>
            <a href="/dashboard/<%= guild.id %><%= it[1] %>" class="<%= active === it[0] ? 'active' : '' %>" title="<%= it[4] %>"><%- gi(it[5]) %><span class="nl"><b><%= it[2] %></b><small><%= it[3] %></small></span></a>
          <% }) %>
        </div>
      <% }) %>
    </nav>
    <div class="nd-foot">
      <a href="/dashboard" class="nd-foot-link">← Все серверы</a>
      <%- include('lang-switch', { cls: 'nd-foot-link nd-lang', labelCls: '' }) %>
      <% if (locals.sys) { %><a class="nd-foot-link" href="/dashboard/<%= guild.id %>/changelog">Бот v<%= sys.bot %> · панель v<%= sys.panel %></a><% } %>
    </div>
  </aside>
</div>

<%# texts of the errors a page may report, read by /js/panel.js (no inline scripts: the page's policy forbids them) %>
<script type="application/json" id="page-errors"><%- JSON.stringify(locals.errorTexts || {}).replace(/</g, '\\u003c') %></script>

<%# hidden until something is edited: "inert" keeps its buttons out of the Tab order meanwhile %>
<div class="save-bar" id="saveBar" inert>
  <span class="sb-text" role="status" aria-live="polite"><svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="10" cy="10" r="7.5"/><path d="M10 6V10.5M10 13.5V13.6" stroke-linecap="round"/></svg><span><b>Есть несохранённые изменения</b><span class="sb-sub">Сохраните, чтобы бот начал работать по-новому</span></span></span>
  <span class="sb-actions">
    <button type="button" class="btn btn-secondary" id="sbReset">Отменить</button>
    <button type="button" class="btn" id="sbSave">Сохранить изменения</button>
  </span>
</div>
<script src="/js/panel.js?v=<%= typeof assetV !== 'undefined' ? assetV : '' %>" defer></script>
