    ["Модерация", [["moderation", "/moderation", "Наказания и журнал", "Предупреждения, муты, баны", "Наказания и журнал — Предупреждения, муты, баны", "<path d=\"M10 2.5L16.5 5V9.5C16.5 13.5 13.7 16.8 10 17.5C6.3 16.8 3.5 13.5 3.5 9.5V5L10 2.5Z\"/>"], ["automod", "/automod", "Автомодерация", "Спам, ссылки, капс", "Автомодерация — Спам, ссылки, капс", "<path d=\"M3 6L10 3L17 6V9C17 13 14 16.5 10 17.5C6 16.5 3 13 3 9V6Z\"/><path d=\"M7.5 9.5L9 11L12.5 7.5\"/>"], ["logs", "/logs", "Логи сервера", "События сервера", "Логи сервера — События сервера", "<path d=\"M5 3H12L15.5 6.5V17H5V3Z\"/><path d=\"M12 3V6.5H15.5M7.5 10H13M7.5 13H11\"/>"]]],
    ["Сервер", [["welcome", "/welcome", "Приветствие", "Приветствие и прощание", "Приветствие — Приветствие и прощание", "<path d=\"M5 17V4.5C5 3.7 5.7 3 6.5 3H12L15 6V17\"/><path d=\"M5 17H15M12 17V3M12 10.2H12.3\"/>"], ["reaction-roles", "/reaction-roles", "Роли по реакциям", "Роли по нажатию на реакцию", "Роли по реакциям — Роли по нажатию на реакцию", "<circle cx=\"10\" cy=\"10\" r=\"7.2\"/><path d=\"M7.3 12C7.9 13 8.9 13.6 10 13.6C11.1 13.6 12.1 13 12.7 12\"/><path d=\"M7.5 8H7.51M12.5 8H12.51\" stroke-width=\"2.2\"/>"], ["interactive", "/interactive", "Интерактивные", "Кнопки и списки с ролями", "Интерактивные — Кнопки и списки с ролями", "<rect x=\"2.5\" y=\"4\" width=\"15\" height=\"12\" rx=\"2\"/><rect x=\"5\" y=\"10\" width=\"4.5\" height=\"3\" rx=\"1\"/><rect x=\"10.5\" y=\"10\" width=\"4.5\" height=\"3\" rx=\"1\"/><path d=\"M5 7H12\"/>"], ["temp-voice", "/temp-voice", "Врем. голосовые", "Личные голосовые комнаты", "Врем. голосовые — Личные голосовые комнаты", "<rect x=\"7.5\" y=\"2.5\" width=\"5\" height=\"8.5\" rx=\"2.5\"/><path d=\"M4.5 9.5C4.5 12.5 7 14.5 10 14.5C13 14.5 15.5 12.5 15.5 9.5M10 14.5V17.5M7 17.5H13\"/>"], ["custom-commands", "/custom-commands", "Кастом-команды", "Свои команды с префиксом", "Кастом-команды — Свои команды с префиксом", "<rect x=\"2.5\" y=\"4\" width=\"15\" height=\"12\" rx=\"1.5\"/><path d=\"M5.5 8L8 10L5.5 12M10.5 12.5H14.5\"/>"], ["alerts", "/alerts", "Оповещения", "Оповещения YouTube и Twitch", "Оповещения — Оповещения YouTube и Twitch", "<path d=\"M5 8C5 5.2 7.2 3 10 3C12.8 3 15 5.2 15 8C15 11.5 16.5 12.5 16.5 13.5H3.5C3.5 12.5 5 11.5 5 8Z\"/><path d=\"M8.3 16C8.6 16.6 9.2 17 10 17C10.8 17 11.4 16.6 11.7 16\"/>"]]],
    ["Инструменты", [["messages", "/messages", "Сообщения", "Конструктор и расписание", "Сообщения — Конструктор и расписание", "<path d=\"M3.5 5C3.5 4.2 4.2 3.5 5 3.5H15C15.8 3.5 16.5 4.2 16.5 5V12C16.5 12.8 15.8 13.5 15 13.5H8L4.5 16.500V13.5H5C4.2 13.5 3.5 12.8 3.5 12Z\"/><path d=\"M7 7.5H13M7 10H11\"/>"], ["webhooks", "/webhooks", "Вебхуки", "Сообщения от имени вебхука", "Вебхуки — Сообщения от имени вебхука", "<circle cx=\"6\" cy=\"14\" r=\"2.3\"/><circle cx=\"14\" cy=\"14\" r=\"2.3\"/><circle cx=\"10\" cy=\"5.5\" r=\"2.3\"/><path d=\"M10 7.8L7.2 12M8.3 14H11.7M10 7.8L12.8 12\"/>"]]]
  ];
   const curGroup = navGroups.find((g) => g[1].some((it) => it[0] === active)) || navGroups[0];
   const gi = (s) => `<svg width="17" height="17" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${s}</svg>`;
   const initial = String(guild.name || '?').trim().charAt(0).toUpperCase(); %>
<header class="topbar" id="topbar">
  <div class="tb-row">
    <button type="button" class="tb-icon tb-burger" data-menu-open aria-label="Все разделы" aria-controls="navDrawer" aria-expanded="false">
      <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><path d="M3.5 6h13M3.5 10h13M3.5 14h13"/></svg>
    </button>
    <a href="/dashboard" class="tb-guild" title="Все серверы">
      <% if (guild.icon) { %><img src="https://cdn.discordapp.com/icons/<%= guild.id %>/<%= guild.icon %>.png" alt="" class="guild-icon" data-initial="<%= initial %>" />
      <% } else { %><span class="guild-icon guild-initial" aria-hidden="true"><%= initial %></span><% } %>
      <span class="tb-guild-name"><%= guild.name %></span>
      <svg class="tb-caret" width="14" height="14" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 8l4 4 4-4"/></svg>
    </a>
    <nav class="tb-groups" aria-label="Группы разделов">
      <% navGroups.forEach((g) => { %><a href="/dashboard/<%= guild.id %><%= g[1][0][1] %>" class="tb-group<%= g === curGroup ? ' is-on' : '' %>"<%- g === curGroup ? ' aria-current="true"' : '' %>><%= g[0] %></a><% }) %>
    </nav>
    <div class="tb-actions">
      <button type="button" class="tb-search" data-quick-jump aria-label="Найти раздел или настройку" title="Найти раздел или настройку (Ctrl+K)">
        <svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><circle cx="8.8" cy="8.8" r="5.3"/><path d="M12.8 12.8L16.5 16.5"/></svg>
        <span class="tb-search-text">Поиск</span><kbd class="qj-kbd">Ctrl K</kbd>
      </button>
      <%- include('lang-switch', { cls: 'tb-icon tb-lang', labelCls: 'sr-only' }) %>
      <button type="button" class="tb-icon tb-theme" data-theme-toggle aria-label="Сменить тему" title="Сменить тему">
        <svg class="ic-sun" width="17" height="17" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><circle cx="10" cy="10" r="3.5"/><path d="M10 2.500v2M10 15.500v2M2.500 10h2M15.500 10h2M4.700 4.700l1.400 1.400M13.900 13.900l1.400 1.400M4.700 15.300l1.400-1.400M13.900 6.100l1.400-1.400"/></svg>
        <svg class="ic-moon" width="17" height="17" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16.500 11.500A6.500 6.500 0 118.500 3.500a5.200 5.200 0 008 8z"/></svg>
      </button>
      <% if (typeof user !== 'undefined' && user) { %>
        <details class="tb-user">
          <summary aria-label="Профиль"><img src="<%= user.avatar ? `https://cdn.discordapp.com/avatars/${user.id}/${user.avatar}.png?size=64` : 'https://cdn.discordapp.com/embed/avatars/0.png' %>" alt="" data-fallback="https://cdn.discordapp.com/embed/avatars/0.png" /></summary>
          <div class="tb-user-menu">
            <div class="tb-user-name"><%= user.global_name || user.username %></div>
            <a href="/dashboard">Все серверы</a>
            <% if (locals.sys) { %><a href="/dashboard/<%= guild.id %>/changelog">Бот v<%= sys.bot %> · панель v<%= sys.panel %></a><% } %>
            <form method="post" action="/auth/logout"><button type="submit">Выйти</button></form>
          </div>
        </details>
      <% } %>
    </div>
  </div>
  <nav class="tb-tabs" aria-label="Разделы: <%= curGroup[0] %>">
    <% curGroup[1].forEach((it) => { %><a href="/dashboard/<%= guild.id %><%= it[1] %>" class="tb-tab<%= it[0] === active ? ' is-on' : '' %>"<%- it[0] === active ? ' aria-current="page"' : '' %>><%- gi(it[5]) %><span><%= it[2] %></span></a><% }) %>
  </nav>
</header>

<div class="nav-drawer" id="navDrawer" hidden>
  <div class="nd-backdrop" data-menu-close></div>
  <aside class="nd-panel" role="dialog" aria-modal="true" aria-label="Все разделы">
    <div class="nd-head">
      <a href="/dashboard" class="tb-guild" title="Все серверы">
        <% if (guild.icon) { %><img src="https://cdn.discordapp.com/icons/<%= guild.id %>/<%= guild.icon %>.png" alt="" class="guild-icon" data-initial="<%= initial %>" />
        <% } else { %><span class="guild-icon guild-initial" aria-hidden="true"><%= initial %></span><% } %>
        <span class="tb-guild-name"><%= guild.name %></span>
      </a>
      <button type="button" class="tb-icon" data-menu-close aria-label="Закрыть меню">
        <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M5 5l10 10M15 5L5 15"/></svg>
      </button>
    </div>
    <button type="button" class="nd-search" data-quick-jump>
      <svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><circle cx="8.8" cy="8.8" r="5.3"/><path d="M12.8 12.8L16.5 16.5"/></svg>
      Найти раздел или настройку
    </button>
    <nav class="nd-nav" aria-label="Меню панели">
      <% navGroups.forEach((g) => { %>
        <div class="nd-group">
          <div class="nd-group-label"><%= g[0] %></div>
          <% g[1].forEach((it) => { %>
            <a href="/dashboard/<%= guild.id %><%= it[1] %>" class="<%= active === it[0] ? 'active' : '' %>" title="<%= it[4] %>"><%- gi(it[5]) %><span class="nl"><b><%= it[2] %></b><small><%= it[3] %></small></span></a>
          <% }) %>
        </div>
      <% }) %>
    </nav>
    <div class="nd-foot">
      <a href="/dashboard" class="nd-foot-link">← Все серверы</a>
      <%- include('lang-switch', { cls: 'nd-foot-link nd-lang', labelCls: '' }) %>
      <% if (locals.sys) { %><a class="nd-foot-link" href="/dashboard/<%= guild.id %>/changelog">Бот v<%= sys.bot %> · панель v<%= sys.panel %></a><% } %>
    </div>
  </aside>
</div>

<script>
  (function () {
    var params = new URLSearchParams(location.search);
    // Error texts by code; the link only carries the code, so it cannot be used to show someone else's words.
    var reasons = <%- JSON.stringify(locals.errorTexts || {}).replace(/</g, '\\u003c') %>;
    function needText(list) {
      var names = { view: 'Просмотр канала', send: 'Отправлять сообщения', embed: 'Встраивать ссылки', history: 'Читать историю сообщений', react: 'Добавлять реакции', connect: 'Подключаться', manage: 'Управлять каналами', move: 'Перемещать участников', files: 'Прикреплять файлы' };
      var parts = String(list || '').split(',');
      if (parts.indexOf('gone') >= 0) return 'Канал не найден — возможно, его удалили. Настройка не изменена';
      var need = parts.map(function (k) { return names[k]; }).filter(Boolean).map(function (n) { return '«' + n + '»'; });
      return 'Бот не сможет работать в этом канале: не хватает прав ' + need.join(', ') + '. Выдайте их боту в настройках канала — канал не сохранён';
    }
    var kinds = {
      saved: ['Изменения сохранены', false],
      deleted: ['Удалено', false],
      invalid: ['Не удалось сохранить: проверьте заполнение полей', true],
      revoked: ['Роль снята', false],
      refunded: ['Покупка возвращена: деньги у покупателя', false],
      gwended: ['Розыгрыш завершён', false],
      gwreroll: ['Победители выбраны заново', false],
      nobot: ['Бот сейчас не в сети — попробуйте через минуту', true],
      revokefail: ['Discord не дал снять роль: проверьте, что роль бота выше', true],
      badterm: ['Не понял срок действия: напишите, например, 10д, 12ч или 1мес (от 1 минуты до 366 дней)', true],
      started: ['Выдача ролей запущена', false],
      running: ['Выдача ролей уже идёт', true],
      nomessage: ['Сообщение не найдено в выбранном канале', true],
      notesent: ['Запись об обновлении отправлена в канал', false],
      rolenotallowed: ['Эту роль выдавать нельзя: у бота нет права «Управлять ролями», роль выше роли бота или вашей, управляется интеграцией либо даёт права модерации', true],
      noperm: [needText(params.get('need')), true],
      isbot: ['У ботов нет профиля, уровня и баланса — выберите участника', true],
      notmember: ['Этого пользователя нет на сервере', true],
      toomany: ['Достигнут предел записей для сервера', true],
      badchannel: ['Выберите канал этого сервера', true],
      badlogin: ['Неверный логин Twitch: латиница, цифры и _, от 3 до 25 символов', true],
      granted: ['Баланс участника обновлён', false],
      adjusted: ['Уровень участника изменён', false],
      baduser: ['Укажите корректный ID участника', true],
      logready: ['Форум логов готов: темы созданы', false],
      logoff: ['Логи отключены', false],
      lognoforum: ['Выберите именно форум — обычные каналы не подходят', true],
      logperm: ['Не хватает прав у бота: нужны «Управлять каналами» и «Управлять вебхуками»', true],
      rules: ['Правила наказаний сохранены', false],
      created: ['Вебхук создан', false],
      wpanel: ['Панель управления вебхуками размещена', false],
      vpanel: ['Панель управления комнатами размещена', false],
      whsent: ['Сообщение отправлено', false],
      msgsaved: ['Заготовка сохранена', false],
      msgsched: ['Сообщение запланировано', false],
      msgtest: ['Тестовое сообщение отправлено', false],
      msgfail: ['Не удалось отправить: причина указана в записи', true],
      msgpast: ['Все даты этой записи уже прошли — измените её', true],
      msgnoright: ['Для вебхука нужно право «Управлять вебхуками»', true],
      whfail: [reasons[params.get('reason')] || 'Не удалось выполнить действие', true],
      logfail: ['Не удалось создать темы. Проверьте права бота в этом форуме', true]
    };
    for (var key in kinds) {
      if (!params.has(key)) continue;
      var t = document.createElement('div');
      t.className = 'toast' + (kinds[key][1] ? ' error' : '');
      t.setAttribute('role', 'status');
      t.innerHTML = '<svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="' +
        (kinds[key][1] ? 'M10 6V11M10 14H10.01' : 'M4.5 10.5L8.2 14L15.5 6') + '"/></svg><span></span>';
      t.lastChild.textContent = kinds[key][0];
      document.body.appendChild(t);
      setTimeout(function () { t.remove(); }, kinds[key][0].length > 90 ? 8000 : 3600);
      params.delete(key);
      params.delete('need');
      var q = params.toString();
      history.replaceState(null, '', location.pathname + (q ? '?' + q : '') + location.hash);
      break;
    }
  })();
</script>

<div class="save-bar" id="saveBar" role="status" aria-live="polite">
  <span class="sb-text"><svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="10" cy="10" r="7.5"/><path d="M10 6V10.5M10 13.5V13.6" stroke-linecap="round"/></svg><span><b>Есть несохранённые изменения</b><span class="sb-sub">Сохраните, чтобы бот начал работать по-новому</span></span></span>
  <span class="sb-actions">
    <button type="button" class="btn btn-secondary" id="sbReset">Отменить</button>
    <button type="button" class="btn" id="sbSave">Сохранить изменения</button>
  </span>
</div>
<script>
  // Shows a "save" bar once any settings form is edited, and warns before leaving with unsaved changes.
  // The forms come after the sidebar in the page, so wait until they exist.
  document.addEventListener('DOMContentLoaded', function () {
    var bar = document.getElementById('saveBar');
    var forms = Array.prototype.filter.call(document.querySelectorAll('.content form[method=post]'), function (f) {
      return f.querySelector('input:not([type=hidden]):not([type=file]), select, textarea') && !f.hasAttribute('data-no-guard');
    });
    // Every edited form is remembered: saving one block must not silently drop changes made in another.
    var dirty = [], submitting = false;
    function mark(f) { if (dirty.indexOf(f) < 0) dirty.push(f); bar.classList.add('show'); document.body.classList.add('has-save-bar'); }
    function post(f) { return fetch(f.action || location.href, { method: 'POST', body: new URLSearchParams(new FormData(f)), credentials: 'same-origin' }); }
    // Saves the other edited forms in the background, then submits this one normally.
    function submitAll(main) {
      var others = dirty.filter(function (f) { return f !== main; });
      submitting = true;
      Promise.all(others.map(post)).catch(function () {}).then(function () { main.requestSubmit ? main.requestSubmit() : main.submit(); });
    }
    // The bar appears by itself on any change, wherever the page is scrolled, so a settings form needs no own "Save" button
    // at its very end. Buttons that do something else (add, publish, delete) stay.
    forms.forEach(function (f) {
      Array.prototype.forEach.call(f.querySelectorAll('button[type=submit], button:not([type])'), function (b) {
        if (/^\s*(Сохранить|Save)/i.test(b.textContent) && !b.classList.contains('btn-danger')) b.classList.add('sb-replaced');
      });
    });
    forms.forEach(function (f) {
      f.addEventListener('input', function () { mark(f); });
      f.addEventListener('change', function () { mark(f); });
      f.addEventListener('submit', function (e) {
        if (submitting) return;
        var others = dirty.filter(function (x) { return x !== f; });
        if (others.length && confirm('В другом блоке на этой странице есть несохранённые изменения. Сохранить их тоже?')) { e.preventDefault(); submitAll(f); return; }
        submitting = true;
      });
    });
    document.getElementById('sbSave').addEventListener('click', function () { if (dirty.length) submitAll(dirty[dirty.length - 1]); });
    document.getElementById('sbReset').addEventListener('click', function () { submitting = true; location.reload(); });
    window.addEventListener('beforeunload', function (e) { if (dirty.length && !submitting) { e.preventDefault(); e.returnValue = ''; } });
  });
</script>
