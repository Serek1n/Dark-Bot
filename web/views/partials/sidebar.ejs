<%# Panel navigation, built from the modules (web/modules.js): "Главная", "Модули ▾" — every module by group, with a switch
   for each — and "Обновления". On narrow screens the "≡" button opens the same list. The search (Ctrl+K) reads the links
   with a title in .nd-nav, so every page of every module is listed there. %>
<% const M = locals.M || global.__darkModules;
   const mods = locals.mods || M.moduleState(locals.settings);
   const gid = guild.id;
   const curMods = M.modulesOfPage(active);
   const inModule = curMods.length > 0;
   const initial = String(guild.name || '?').trim().charAt(0).toUpperCase();
   const offTitle = 'Выключить модуль', onTitle = 'Включить модуль', coreTitle = 'Этот модуль нельзя выключить', always = 'всегда';
   const modSwitch = (m, cls) => m.switchable
     ? '<label class="mod-sw' + (cls ? ' ' + cls : '') + '" title="' + (m.on ? offTitle : onTitle) + '"><input type="checkbox" data-mod-switch="' + m.key + '" data-mod-title="' + m.title + '"' + (m.on ? ' checked' : '') + ' aria-label="' + m.title + '"></label>'
     : '<span class="mod-core" title="' + coreTitle + '">' + always + '</span>'; %>
<a class="skip-link" href="#main">Перейти к содержимому</a>
<header class="topbar" id="topbar" data-guild="<%= gid %>" data-page-mods="<%= curMods.map((m) => m.key).join(' ') %>">
  <div class="tb-row">
    <button type="button" class="tb-icon tb-burger" data-menu-open aria-label="Все разделы" aria-controls="navDrawer" aria-expanded="false">
      <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><path d="M3.5 6h13M3.5 10h13M3.5 14h13"/></svg>
    </button>
    <a href="/dashboard" class="tb-guild" title="Все серверы">
      <% if (guild.icon) { %><img src="https://cdn.discordapp.com/icons/<%= gid %>/<%= guild.icon %>.png" alt="" class="guild-icon" data-initial="<%= initial %>" />
      <% } else { %><span class="guild-icon guild-initial" aria-hidden="true"><%= initial %></span><% } %>
      <span class="tb-guild-name"><%= guild.name %></span>
    </a>
    <nav class="tb-groups" aria-label="Разделы панели">
      <a href="/dashboard/<%= gid %>" class="tb-group<%= active === 'overview' ? ' is-on' : '' %>"<%- active === 'overview' ? ' aria-current="page"' : '' %>>Главная</a>
      <button type="button" class="tb-group tb-mods<%= inModule || active === 'features' ? ' is-on' : '' %>" data-mods-open aria-expanded="false" aria-controls="modsMenu">Модули <span class="tb-count" data-mods-count><%= mods.on %></span><svg width="12" height="12" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 8l4 4 4-4"/></svg></button>
      <a href="/dashboard/<%= gid %>/changelog" class="tb-group<%= active === 'changelog' ? ' is-on' : '' %>"<%- active === 'changelog' ? ' aria-current="page"' : '' %>>Обновления</a>
    </nav>
    <div class="tb-actions">
      <button type="button" class="tb-search" data-quick-jump aria-label="Найти раздел или настройку" title="Найти раздел или настройку (Ctrl+K)">
        <svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><circle cx="8.8" cy="8.8" r="5.3"/><path d="M12.8 12.8L16.5 16.5"/></svg>
        <span class="tb-search-text">Поиск</span><kbd class="qj-kbd">Ctrl K</kbd>
      </button>
      <%- include('lang-switch', { cls: 'tb-icon tb-lang', labelCls: 'sr-only' }) %>
      <button type="button" class="tb-icon tb-theme" data-theme-toggle aria-label="Сменить тему" title="Сменить тему">
        <svg class="ic-sun" width="17" height="17" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><circle cx="10" cy="10" r="3.5"/><path d="M10 2.500v2M10 15.500v2M2.500 10h2M15.500 10h2M4.700 4.700l1.400 1.400M13.900 13.900l1.400 1.400M4.700 15.300l1.400-1.400M13.900 6.100l1.400-1.400"/></svg>
        <svg class="ic-moon" width="17" height="17" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16.500 11.500A6.500 6.500 0 118.500 3.500a5.200 5.200 0 008 8z"/></svg>
      </button>
      <% if (typeof user !== 'undefined' && user) { %>
        <details class="tb-user">
          <summary aria-label="Профиль"><img src="<%= user.avatar ? `https://cdn.discordapp.com/avatars/${user.id}/${user.avatar}.png?size=64` : 'https://cdn.discordapp.com/embed/avatars/0.png' %>" alt="" data-fallback="https://cdn.discordapp.com/embed/avatars/0.png" /></summary>
          <div class="tb-user-menu">
            <div class="tb-user-name"><%= user.global_name || user.username %></div>
            <a href="/dashboard">Все серверы</a>
            <% if (locals.sys) { %><a href="/dashboard/<%= gid %>/changelog">Бот v<%= sys.bot %> · панель v<%= sys.panel %></a><% } %>
            <form method="post" action="/auth/logout"><button type="submit">Выйти</button></form>
          </div>
        </details>
      <% } %>
    </div>
  </div>

  <div class="mods-menu" id="modsMenu" hidden>
    <div class="mm-head">
      <label class="mm-search"><svg width="15" height="15" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="9" cy="9" r="5.5"/><path d="M13 13L17 17"/></svg><input type="search" placeholder="Найти модуль" aria-label="Найти модуль" data-mods-filter autocomplete="off"></label>
      <span class="mm-count">Включено <b data-mods-count><%= mods.on %></b> из <%= mods.total %></span>
      <a class="mm-all" href="/dashboard/<%= gid %>/features">Все модули ›</a>
    </div>
    <div class="mm-cols">
      <% mods.groups.forEach((g) => { %>
        <div class="mm-col">
          <div class="mm-cat"><%= g.title %> <small><%= g.modules.filter((m) => m.on).length %>/<%= g.modules.length %></small></div>
          <% g.modules.forEach((m) => { %>
            <div class="mm-row<%= m.on ? ' is-on' : ' is-off' %><%= curMods.some((c) => c.key === m.key) ? ' is-cur' : '' %>" data-mod-row="<%= m.key %>" data-mod-name="<%= m.title.toLowerCase() %>">
              <a href="<%= m.page ? `/dashboard/${gid}/${m.page}` : `/dashboard/${gid}?m=${m.key}` %>"><%- M.icon(m.key, 16) %><span><%= m.title %></span></a>
              <%- modSwitch(m, 'sm') %>
            </div>
          <% }) %>
        </div>
      <% }) %>
    </div>
    <div class="mm-foot">Переключатель включает и выключает модуль сразу. Настройки и данные выключенного модуля сохраняются.</div>
  </div>
</header>

<div class="nav-drawer" id="navDrawer" hidden>
  <div class="nd-backdrop" data-menu-close></div>
  <aside class="nd-panel" role="dialog" aria-modal="true" aria-label="Все разделы">
    <div class="nd-head">
      <a href="/dashboard" class="tb-guild" title="Все серверы">
        <% if (guild.icon) { %><img src="https://cdn.discordapp.com/icons/<%= gid %>/<%= guild.icon %>.png" alt="" class="guild-icon" data-initial="<%= initial %>" />
        <% } else { %><span class="guild-icon guild-initial" aria-hidden="true"><%= initial %></span><% } %>
        <span class="tb-guild-name"><%= guild.name %></span>
      </a>
      <button type="button" class="tb-icon" data-menu-close aria-label="Закрыть меню">
        <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M5 5l10 10M15 5L5 15"/></svg>
      </button>
    </div>
    <button type="button" class="nd-search" data-quick-jump>
      <svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><circle cx="8.8" cy="8.8" r="5.3"/><path d="M12.8 12.8L16.5 16.5"/></svg>
      Найти раздел или настройку
    </button>
    <nav class="nd-nav" aria-label="Меню панели">
      <div class="nd-group">
        <a href="/dashboard/<%= gid %>" class="<%= active === 'overview' ? 'active' : '' %>" title="Главная — сводка по серверу"><%- M.icon('home', 17) %><span class="nl"><b>Главная</b><small>Сводка по серверу</small></span></a>
        <a href="/dashboard/<%= gid %>/features" class="<%= active === 'features' ? 'active' : '' %>" title="Модули — что включено на сервере"><%- M.icon('modules', 17) %><span class="nl"><b>Модули</b><small>Что включено на сервере</small></span></a>
        <a href="/dashboard/<%= gid %>/changelog" class="<%= active === 'changelog' ? 'active' : '' %>" title="Обновления — что нового в боте и панели"><%- M.icon('changelog', 17) %><span class="nl"><b>Обновления</b><small>Что нового в боте и панели</small></span></a>
      </div>
      <% mods.groups.forEach((g) => { %>
        <div class="nd-group">
          <div class="nd-group-label"><%= g.title %></div>
          <% g.modules.forEach((m) => { %>
            <div class="nd-mod<%= m.on ? ' is-on' : ' is-off' %>" data-mod-row="<%= m.key %>">
              <a href="<%= m.page ? `/dashboard/${gid}/${m.page}` : `/dashboard/${gid}?m=${m.key}` %>" class="<%= curMods.some((c) => c.key === m.key) && m.page === active ? 'active' : '' %>" title="<%= m.title %> — <%= m.desc %>"><%- M.icon(m.key, 17) %><span class="nl"><b><%= m.title %></b></span></a>
              <%- modSwitch(m, 'sm') %>
            </div>
            <% m.pages.slice(1).filter((p) => M.PAGE_LABELS[p] && !mods.list.some((o) => o.page === p) && M.pageVisible(p, locals.settings)).forEach((p) => { %>
              <a href="/dashboard/<%= gid %>/<%= p %>" class="nd-sub<%= active === p ? ' active' : '' %>" title="<%= M.PAGE_LABELS[p] %> — <%= m.title %>"><span class="nl"><b><%= M.PAGE_LABELS[p] %></b></span></a>
            <% }) %>
          <% }) %>
        </div>
      <% }) %>
    </nav>
    <div class="nd-foot">
      <a href="/dashboard" class="nd-foot-link">← Все серверы</a>
      <%- include('lang-switch', { cls: 'nd-foot-link nd-lang', labelCls: '' }) %>
      <% if (locals.sys) { %><a class="nd-foot-link" href="/dashboard/<%= gid %>/changelog">Бот v<%= sys.bot %> · панель v<%= sys.panel %></a><% } %>
    </div>
  </aside>
</div>

<%# the modules for /js/modules.js: names, commands and what depends on what (for the "switch off?" window) %>
<script type="application/json" id="mods-data"><%- JSON.stringify(mods.list.map((m) => ({ key: m.key, title: m.title, on: m.on, switchable: m.switchable, depends: m.depends, commands: m.commands }))).replace(/</g, '\\u003c') %></script>

<%# texts of the errors a page may report, read by /js/panel.js (no inline scripts: the page's policy forbids them) %>
<script type="application/json" id="page-errors"><%- JSON.stringify(locals.errorTexts || {}).replace(/</g, '\\u003c') %></script>

<%# hidden until something is edited: "inert" keeps its buttons out of the Tab order meanwhile %>
<div class="save-bar" id="saveBar" inert>
  <span class="sb-text" role="status" aria-live="polite"><svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="10" cy="10" r="7.5"/><path d="M10 6V10.5M10 13.5V13.6" stroke-linecap="round"/></svg><span><b>Есть несохранённые изменения</b><span class="sb-sub">Сохраните, чтобы бот начал работать по-новому</span></span></span>
  <span class="sb-actions">
    <button type="button" class="btn btn-secondary" id="sbReset">Отменить</button>
    <button type="button" class="btn" id="sbSave">Сохранить изменения</button>
  </span>
</div>
<script src="/js/panel.js?v=<%= typeof assetV !== 'undefined' ? assetV : '' %>" defer></script>
<script src="/js/modules.js?v=<%= typeof assetV !== 'undefined' ? assetV : '' %>" defer></script>
