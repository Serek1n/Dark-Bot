<%# The switch of the seasonal look (web/utils/season.js). Shown only while a season runs; the choice stays in this browser
   (js/theme.js). Variants: "icon" — a round button of the top bar, "pill" — a button with a name and a small switch,
   "row" — a line of a menu. The state is drawn by CSS from <html data-season>, so there is no flash before the script. %>
<% if (locals.season) { const v = locals.variant || 'pill'; %>
<button type="button" class="season-sw season-sw-<%= v %><%= locals.cls ? ' ' + cls : '' %>" data-season-toggle role="switch" aria-checked="true" aria-label="Оформление Vice Nights" title="Оформление Vice Nights">
  <svg class="ss-ic" width="17" height="17" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9.6 18.2c-.3-3.6.2-6.900 1.6-9.800"/><path d="M11.2 8.400C9.300 6.200 6.300 5.700 3.700 7.200"/><path d="M11.2 8.400C10.700 5.600 8.600 3.600 5.800 3.400"/><path d="M11.2 8.400c.9-2.800 3.300-4.400 6.100-4"/><path d="M11.2 8.400c2.800-.6 5.200.6 6.400 3"/><path d="M4 18.300h12"/></svg>
  <% if (v !== 'icon') { %><span class="ss-name">Vice Nights<% if (v === 'row') { %> <small>до 30 ноября</small><% } %></span><span class="ss-knob" aria-hidden="true"></span><% } %>
</button>
<% } %>
